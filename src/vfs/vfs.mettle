// freedrs/vfs/vfs: the virtual file system.
//
// File bytes live under a root directory on disk (std/file, std/fs); the
// metadata (path, kind, size, owner, created, modified) lives in MeoDB through
// flux_orm (db/store.mettle: fd_entry_*). A virtual path is a normalised,
// slash separated string without a leading slash ("" is the root, "docs/a.txt"
// a file), at most FD_PATH_MAX bytes.
//
// fd_vfs_resolve turns what a client typed (absolute or relative to its working
// directory) into a virtual path. It is the only way in, and it cannot produce a
// path that leaves the root: "." and empty segments are dropped, ".." pops a
// segment and is an error (FD_E_TRAVERSAL) when there is nothing to pop, and
// backslashes, control characters and NUL are refused. The disk path is
// root + "/" + virtual path.
//
// One mutex serialises every operation that changes or reads the tree, so
// check-then-act sequences (exists, then write) are not interleaved.
//
// MeoDB is the source of the entry list. Files that appear under the root
// without going through the server are added to it by fd_vfs_refresh (at
// startup and on the `refresh` command).
//
// Uploads are written to a temp file in root/.freedrs-tmp (mode 0700, emptied
// by fd_vfs_init), then renamed into place by fd_vfs_commit. That name is
// reserved: the resolver refuses it and refresh skips it. Temp files are
// created with O_CREAT|O_EXCL, which never follows a link at the name, and
// a link found where the temp directory or a file being opened should be is
// refused (fs_lstat) instead of followed.

import "std/mem";
import "std/conv";
import "std/file";
import "std/fs";
import "std/sync";
import "crypto/crypto";
import "freedrs/status";
import "freedrs/auth/roles";
import "freedrs/db/store";
import "freedrs/db/models";

/// The temp directory under the root (a reserved name).
export const FD_VFS_TMP: string = ".freedrs-tmp";
const FD_ROOT_CAP: int32 = 256;
const FD_DISK_CAP: int32 = 1024;

export struct FdVfs {
  db: FdDb*;
  root: uint8[256];
  root_len: int32;
  lock: SyncMutex;
}

/// The root directory on disk (a view into v).
export fn fd_vfs_root(v: FdVfs*) -> string {
  return str_from_bytes((cstring)&v->root[0], (int64)v->root_len);
}

/// A virtual path in a fixed buffer.
export struct FdVPath {
  buf: uint8[512];
  len: int32;
}

export fn fd_vpath_str(p: FdVPath*) -> string {
  return str_from_bytes((cstring)&p->buf[0], (int64)p->len);
}

fn fd_vp_push(p: FdVPath*, seg_start: int64, seg: string) -> bool {
  var need: int64 = (int64)seg.length;
  if (p->len > 0) { need = need + 1; }
  if ((int64)p->len + need > (int64)FD_PATH_MAX) { return false; }
  if (p->len > 0) { p->buf[p->len] = (uint8)'/'; p->len = p->len + 1; }
  memcpy((rawptr)&p->buf[p->len], (rawptr)seg.chars, (int64)seg.length);
  p->len = p->len + (int32)seg.length;
  return true;
}

// Removes the last segment. False when the path is already the root.
fn fd_vp_pop(p: FdVPath*) -> bool {
  if (p->len == 0) { return false; }
  var i: int32 = p->len - 1;
  while (i >= 0 && p->buf[i] != (uint8)'/') { i = i - 1; }
  if (i < 0) { p->len = 0; } else { p->len = i; }
  return true;
}

fn fd_seg_ok(seg: string) -> bool {
  var i: int64 = 0;
  while (i < (int64)seg.length) {
    var c: int32 = (int32)(uint8)seg.chars[i];
    if (c < 32 || c == 127 || c == 92) { return false; }
    i = i + 1;
  }
  return true;
}

// Applies the segments of `s` onto `out` (see fd_vfs_resolve).
fn fd_vp_apply(out: FdVPath*, s: string) -> int32 {
  var n: int64 = (int64)s.length;
  var start: int64 = 0;
  var i: int64 = 0;
  while (i <= n) {
    if (i == n || s.chars[i] == '/') {
      var seg: string = str_slice(s, start, i - start);
      start = i + 1;
      if (seg.length == 0 || seg == ".") {
        // nothing
      } else if (seg == "..") {
        if (!fd_vp_pop(out)) { return FD_E_TRAVERSAL; }
      } else {
        if (!fd_seg_ok(seg)) { return FD_E_TRAVERSAL; }
        if (!fd_vp_push(out, 0, seg)) { return FD_E_INVALID; }
      }
    }
    i = i + 1;
  }
  return FD_OK;
}

/// Resolves `input` against the working directory `cwd` ("/" or "/a/b").
/// A leading slash makes `input` absolute. The result is a clean virtual path.
///
/// returns: FD_OK; FD_E_TRAVERSAL (escapes the root, bad character);
///          FD_E_INVALID (empty input or too long)
export fn fd_vfs_resolve(cwd: string, input: string, out: FdVPath*) -> int32 {
  if (out == 0) { return FD_E_USAGE; }
  out->len = 0;
  var s: string = str_trim(input);
  if (s.length == 0) { return FD_E_INVALID; }
  var rc: int32 = FD_OK;
  if (s.chars[0] != '/') {
    rc = fd_vp_apply(out, cwd);
    if (rc != FD_OK) { return rc; }
  }
  rc = fd_vp_apply(out, s);
  if (rc == FD_OK && fd_vp_reserved(out)) { return FD_E_INVALID; }
  return rc;
}

// True when the path is the temp directory or inside it.
fn fd_vp_reserved(p: FdVPath*) -> bool {
  var v: string = fd_vpath_str(p);
  var n: int64 = (int64)FD_VFS_TMP.length;
  if (str_starts_with(v, FD_VFS_TMP) == 0) { return false; }
  return (int64)v.length == n || v.chars[n] == '/';
}

/// Like fd_vfs_resolve, but an empty `input` means the working directory itself.
export fn fd_vfs_resolve_or_cwd(cwd: string, input: string, out: FdVPath*) -> int32 {
  if (str_trim(input).length == 0) {
    if (out == 0) { return FD_E_USAGE; }
    out->len = 0;
    return fd_vp_apply(out, cwd);
  }
  return fd_vfs_resolve(cwd, input, out);
}

// ---- disk paths ----

struct FdDiskPath {
  buf: uint8[1024];
  len: int32;
}

fn fd_disk_str(d: FdDiskPath*) -> string {
  return str_from_bytes((cstring)&d->buf[0], (int64)d->len);
}

// root + "/" + vpath (+ NUL after len, for the cstring dir calls).
fn fd_disk_path(v: FdVfs*, vpath: string, d: FdDiskPath*) -> bool {
  var total: int64 = (int64)v->root_len + 1 + (int64)vpath.length;
  if (total >= (int64)FD_DISK_CAP) { return false; }
  memcpy((rawptr)&d->buf[0], (rawptr)&v->root[0], (int64)v->root_len);
  var n: int32 = v->root_len;
  if (vpath.length > 0) {
    d->buf[n] = (uint8)'/';
    n = n + 1;
    memcpy((rawptr)&d->buf[n], (rawptr)vpath.chars, (int64)vpath.length);
    n = n + (int32)vpath.length;
  }
  d->buf[n] = (uint8)0;
  d->len = n;
  return true;
}

// Creates `disk` and every missing parent. Existing directories are fine.
fn fd_mkdir_p(disk: string) -> int32 {
  // 0x1ED is mode 0755
  if (fs_mkdir_all(disk, 0x1ED) != 0) { return FD_E_IO; }
  return FD_OK;
}

// The directory part of a virtual path ("" for a top-level name).
fn fd_vpath_parent(vpath: string) -> string {
  var i: int64 = (int64)vpath.length - 1;
  while (i >= 0 && vpath.chars[i] != '/') { i = i - 1; }
  if (i < 0) { return ""; }
  return str_slice(vpath, 0, i);
}

// ---- operations ----

/// Opens the VFS over root (created when missing, with parents) and empties
/// its temp directory.
/// returns: FD_OK; FD_E_INVALID (root empty or too long); FD_E_IO
export fn fd_vfs_init(v: FdVfs*, db: FdDb*, root: string) -> int32 {
  if (v == 0 || db == 0) { return FD_E_USAGE; }
  if (root.length == 0 || (int64)root.length >= (int64)FD_ROOT_CAP) { return FD_E_INVALID; }
  memset((rawptr)v, 0, (int64)sizeof(FdVfs));
  v->db = db;
  memcpy((rawptr)&v->root[0], (rawptr)root.chars, (int64)root.length);
  v->root_len = (int32)root.length;
  // a trailing slash would double up in disk paths
  while (v->root_len > 1 && v->root[v->root_len - 1] == (uint8)'/') { v->root_len = v->root_len - 1; }
  var rc: int32 = fd_mkdir_p(str_from_bytes((cstring)&v->root[0], (int64)v->root_len));
  if (rc != FD_OK) { return rc; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, FD_VFS_TMP, &d)) { return FD_E_INVALID; }
  fs_remove_all(fd_disk_str(&d));   // links are removed, not followed
  return fd_tmp_dir(v);
}

/// Creates a directory entry (and the directory on disk, with parents).
/// returns: FD_OK; FD_E_EXISTS; FD_E_INVALID (root, or a file is in the way); FD_E_IO; FD_E_DB
export fn fd_vfs_mkdir(v: FdVfs*, vpath: string, owner: string) -> int32 {
  if (v == 0 || vpath.length == 0) { return FD_E_INVALID; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, vpath, &d)) { return FD_E_INVALID; }
  sync_mutex_lock(&v->lock);
  var e: FdEntryInfo;
  var rc: int32 = fd_entry_get(v->db, vpath, &e);
  if (rc == FD_OK) { sync_mutex_unlock(&v->lock); return FD_E_EXISTS; }
  if (rc != FD_E_NOT_FOUND) { sync_mutex_unlock(&v->lock); return rc; }
  rc = fd_mkdir_p(fd_disk_str(&d));
  if (rc == FD_OK) { rc = fd_entry_add(v->db, vpath, FD_KIND_DIR, 0, owner); }
  sync_mutex_unlock(&v->lock);
  return rc;
}

/// Writes (creates or replaces) a file from memory: bytes to disk, entry to
/// MeoDB. Uploads use the temp file calls below instead.
/// returns: FD_OK; FD_E_INVALID (a directory is there, or the path is the
///          root); FD_E_IO; FD_E_DB
export fn fd_vfs_write(v: FdVfs*, vpath: string, data: uint8*, n: int64, owner: string) -> int32 {
  if (v == 0 || vpath.length == 0 || n < 0) { return FD_E_INVALID; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, vpath, &d)) { return FD_E_INVALID; }
  var pd: FdDiskPath;
  if (!fd_disk_path(v, fd_vpath_parent(vpath), &pd)) { return FD_E_INVALID; }
  sync_mutex_lock(&v->lock);
  var e: FdEntryInfo;
  var rc: int32 = fd_entry_get(v->db, vpath, &e);
  var exists: bool = rc == FD_OK;
  if (exists && e.kind == FD_KIND_DIR) { sync_mutex_unlock(&v->lock); return FD_E_INVALID; }
  if (!exists && rc != FD_E_NOT_FOUND) { sync_mutex_unlock(&v->lock); return rc; }
  rc = fd_mkdir_p(fd_disk_str(&pd));
  if (rc != FD_OK) { sync_mutex_unlock(&v->lock); return rc; }
  var fd: int64 = file_open(fd_disk_str(&d), FILE_WRITE | FILE_CREATE | FILE_TRUNCATE);
  if (fd < 0) { sync_mutex_unlock(&v->lock); return FD_E_IO; }
  var off: int64 = 0;
  while (off < n) {
    var w: int64 = file_write_at(fd, data + off, n - off, off);
    if (w <= 0) { file_close(fd); sync_mutex_unlock(&v->lock); return FD_E_IO; }
    off = off + w;
  }
  file_close(fd);
  if (exists) { rc = fd_entry_touch(v->db, vpath, n, ""); }
  else { rc = fd_entry_add(v->db, vpath, FD_KIND_FILE, n, owner); }
  sync_mutex_unlock(&v->lock);
  return rc;
}

/// The size of a file entry, for sizing a read buffer.
/// returns: FD_OK; FD_E_NOT_FOUND (no entry, or a directory)
export fn fd_vfs_size(v: FdVfs*, vpath: string, size: int64*) -> int32 {
  if (v == 0 || size == 0 || vpath.length == 0) { return FD_E_USAGE; }
  var e: FdEntryInfo;
  var rc: int32 = fd_entry_get(v->db, vpath, &e);
  if (rc != FD_OK) { return rc; }
  if (e.kind != FD_KIND_FILE) { return FD_E_NOT_FOUND; }
  *size = e.size;
  return FD_OK;
}

/// Reads a file into buf (capacity cap), setting *n.
/// returns: FD_OK; FD_E_NOT_FOUND; FD_E_TOO_BIG (cap too small); FD_E_IO
export fn fd_vfs_read(v: FdVfs*, vpath: string, buf: uint8*, cap: int64, n: int64*) -> int32 {
  if (v == 0 || buf == 0 || n == 0 || vpath.length == 0) { return FD_E_USAGE; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, vpath, &d)) { return FD_E_INVALID; }
  sync_mutex_lock(&v->lock);
  var e: FdEntryInfo;
  var rc: int32 = fd_entry_get(v->db, vpath, &e);
  if (rc != FD_OK || e.kind != FD_KIND_FILE) {
    sync_mutex_unlock(&v->lock);
    if (rc == FD_OK) { return FD_E_NOT_FOUND; }
    return rc;
  }
  var fd: int64 = file_open(fd_disk_str(&d), FILE_READ);
  if (fd < 0) { sync_mutex_unlock(&v->lock); return FD_E_NOT_FOUND; }
  var size: int64 = file_size(fd);
  if (size < 0) { file_close(fd); sync_mutex_unlock(&v->lock); return FD_E_IO; }
  if (size > cap) { file_close(fd); sync_mutex_unlock(&v->lock); return FD_E_TOO_BIG; }
  var off: int64 = 0;
  while (off < size) {
    var r: int64 = file_read_at(fd, buf + off, size - off, off);
    if (r <= 0) { break; }
    off = off + r;
  }
  file_close(fd);
  sync_mutex_unlock(&v->lock);
  if (off != size) { return FD_E_IO; }
  *n = size;
  return FD_OK;
}

/// Deletes a file or an empty directory.
/// `user` and `is_admin` decide ownership: only the owner or an admin may.
/// returns: FD_OK; FD_E_NOT_FOUND; FD_E_DENIED; FD_E_NOT_EMPTY; FD_E_IO; FD_E_DB
export fn fd_vfs_delete(v: FdVfs*, vpath: string, user: string, is_admin: bool) -> int32 {
  if (v == 0 || vpath.length == 0) { return FD_E_INVALID; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, vpath, &d)) { return FD_E_INVALID; }
  sync_mutex_lock(&v->lock);
  var e: FdEntryInfo;
  var rc: int32 = fd_entry_get(v->db, vpath, &e);
  if (rc != FD_OK) { sync_mutex_unlock(&v->lock); return rc; }
  if (!is_admin && fd_entry_info_owner(&e) != user) { sync_mutex_unlock(&v->lock); return FD_E_DENIED; }
  if (e.kind == FD_KIND_DIR) {
    var kids: FdEntryInfo[1];
    var n: int32 = 0;
    var pbuf: uint8[520];
    memcpy((rawptr)&pbuf[0], (rawptr)vpath.chars, (int64)vpath.length);
    pbuf[(int64)vpath.length] = (uint8)'/';
    var prefix: string = str_from_bytes((cstring)&pbuf[0], (int64)vpath.length + 1);
    rc = fd_entry_list(v->db, prefix, &kids[0], 1, &n);
    if (rc != FD_OK) { sync_mutex_unlock(&v->lock); return rc; }
    if (n > 0) { sync_mutex_unlock(&v->lock); return FD_E_NOT_EMPTY; }
    var r: int64 = fs_rmdir(fd_disk_str(&d));
    if (r == -(int64)FS_ENOTEMPTY) { sync_mutex_unlock(&v->lock); return FD_E_NOT_EMPTY; }
    if (r < 0 && r != -(int64)FS_ENOENT) { sync_mutex_unlock(&v->lock); return FD_E_IO; }
  } else {
    var r: int64 = file_remove(fd_disk_str(&d));
    if (r < 0 && r != -(int64)FILE_ENOENT) { sync_mutex_unlock(&v->lock); return FD_E_IO; }
  }
  rc = fd_entry_delete(v->db, vpath);
  sync_mutex_unlock(&v->lock);
  return rc;
}

// ---- temp files and commit ----

/// A temp file's name inside the temp directory.
export struct FdTmpName {
  buf: uint8[48];
  len: int32;
}

export fn fd_tmp_name_str(t: FdTmpName*) -> string {
  return str_from_bytes((cstring)&t->buf[0], (int64)t->len);
}

// root/.freedrs-tmp/name
fn fd_tmp_path(v: FdVfs*, name: string, d: FdDiskPath*) -> bool {
  var n: int64 = (int64)FD_VFS_TMP.length + 1 + (int64)name.length;
  if (n > 120) { return false; }
  var buf: uint8[128];
  memcpy((rawptr)&buf[0], (rawptr)FD_VFS_TMP.chars, (int64)FD_VFS_TMP.length);
  buf[(int64)FD_VFS_TMP.length] = (uint8)'/';
  memcpy((rawptr)&buf[(int64)FD_VFS_TMP.length + 1], (rawptr)name.chars, (int64)name.length);
  return fd_disk_path(v, str_from_bytes((cstring)&buf[0], n), d);
}

// Makes sure root/.freedrs-tmp is a real directory: a link there is removed
// (never followed) and the directory made again, mode 0700.
fn fd_tmp_dir(v: FdVfs*) -> int32 {
  var d: FdDiskPath;
  if (!fd_disk_path(v, FD_VFS_TMP, &d)) { return FD_E_INVALID; }
  var st: FsStat;
  if (fs_lstat(fd_disk_str(&d), &st) == 0) {
    if (st.kind == FS_DIR) { return FD_OK; }
    if (st.kind != FS_SYMLINK) { return FD_E_IO; }
    if (file_remove(fd_disk_str(&d)) < 0) { return FD_E_IO; }   // unlinks the link itself
  }
  var r: int64 = fs_mkdir(fd_disk_str(&d), 0x1C0);   // 0700
  if (r != 0 && r != -(int64)FS_EEXIST) { return FD_E_IO; }
  if (fs_lstat(fd_disk_str(&d), &st) != 0 || st.kind != FS_DIR) { return FD_E_IO; }
  return FD_OK;
}

/// Creates a new, empty temp file with a random name and opens it for reading
/// and writing. The file is created exclusively, so nothing that is already at
/// the name (a link included) is opened.
/// returns: FD_OK, *name and *fd; FD_E_IO; FD_E_CRYPTO (no random bytes)
export fn fd_vfs_tmp_create(v: FdVfs*, name: FdTmpName*, fd: int64*) -> int32 {
  if (v == 0 || name == 0 || fd == 0) { return FD_E_USAGE; }
  var rc: int32 = fd_tmp_dir(v);
  if (rc != FD_OK) { return rc; }
  var rnd: uint8[16];
  if (cr_random_bytes(&rnd[0], 16) != CR_OK) { return FD_E_CRYPTO; }
  memcpy((rawptr)&name->buf[0], (rawptr)".up-".chars, 4);
  var hl: int64 = 0;
  if (cr_hex_encode(&name->buf[4], 44, &hl, &rnd[0], 16) != CR_OK) { return FD_E_CRYPTO; }
  name->len = 4 + (int32)hl;
  var d: FdDiskPath;
  if (!fd_tmp_path(v, fd_tmp_name_str(name), &d)) { return FD_E_INVALID; }
  var f: int64 = file_open(fd_disk_str(&d), FILE_READ | FILE_WRITE | FILE_CREATE | FILE_NEW);
  if (f < 0) { return FD_E_IO; }
  *fd = f;
  return FD_OK;
}

/// Opens an existing temp file again (a resumed upload). Anything but a
/// regular file at the name is refused.
/// returns: FD_OK and *fd; FD_E_NOT_FOUND; FD_E_DENIED (not a regular file); FD_E_IO
export fn fd_vfs_tmp_open(v: FdVfs*, name: string, fd: int64*) -> int32 {
  if (v == 0 || fd == 0 || name.length == 0) { return FD_E_USAGE; }
  if (fd_tmp_dir(v) != FD_OK) { return FD_E_IO; }
  var d: FdDiskPath;
  if (!fd_tmp_path(v, name, &d)) { return FD_E_INVALID; }
  var st: FsStat;
  if (fs_lstat(fd_disk_str(&d), &st) != 0) { return FD_E_NOT_FOUND; }
  if (st.kind != FS_FILE) { return FD_E_DENIED; }
  var f: int64 = file_open(fd_disk_str(&d), FILE_READ | FILE_WRITE);
  if (f < 0) { return FD_E_IO; }
  *fd = f;
  return FD_OK;
}

/// Removes a temp file (a link at the name is unlinked, not followed).
export fn fd_vfs_tmp_remove(v: FdVfs*, name: string) {
  if (v == 0 || name.length == 0) { return; }
  var d: FdDiskPath;
  if (fd_tmp_path(v, name, &d)) { file_remove(fd_disk_str(&d)); }
}

/// Names in the temp directory, for tests: the count of entries.
export fn fd_vfs_tmp_count(v: FdVfs*) -> int32 {
  var d: FdDiskPath;
  if (!fd_disk_path(v, FD_VFS_TMP, &d)) { return -1; }
  var dir: FsDir* = (FsDir*)malloc((int64)sizeof(FsDir));
  if (dir == 0) { return -1; }
  if (fs_dir_open(fd_disk_str(&d), dir) != 0) { free((rawptr)dir); return -1; }
  var n: int32 = 0;
  var ent: FsDirEntry;
  while (fs_dir_next(dir, &ent) > 0) {
    if (ent.name != "." && ent.name != "..") { n = n + 1; }
  }
  fs_dir_close(dir);
  free((rawptr)dir);
  return n;
}

// Flushes a directory's entries (a rename in it) to the device.
fn fd_sync_dir(disk: string) {
  var fd: int64 = file_open(disk, FILE_READ);
  if (fd < 0) { return; }
  file_sync(fd);
  file_close(fd);
}

/// Moves a finished temp file into place at vpath and writes its entry (size,
/// owner for a new file, SHA-256 hex). The rename is atomic and replaces a
/// link at vpath rather than following it. With quota > 0 the owner's stored
/// bytes, less the old file if it is theirs, plus `size` must stay within it.
/// The caller has already synced the file.
/// returns: FD_OK; FD_E_QUOTA; FD_E_INVALID (a directory is there); FD_E_IO; FD_E_DB
export fn fd_vfs_commit(v: FdVfs*, vpath: string, tmp: string, size: int64, owner: string, sha256: string,
                        quota: int64) -> int32 {
  if (v == 0 || vpath.length == 0 || size < 0) { return FD_E_INVALID; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, vpath, &d)) { return FD_E_INVALID; }
  var pd: FdDiskPath;
  if (!fd_disk_path(v, fd_vpath_parent(vpath), &pd)) { return FD_E_INVALID; }
  var td: FdDiskPath;
  if (!fd_tmp_path(v, tmp, &td)) { return FD_E_INVALID; }
  sync_mutex_lock(&v->lock);
  var e: FdEntryInfo;
  var rc: int32 = fd_entry_get(v->db, vpath, &e);
  var exists: bool = rc == FD_OK;
  if (exists && e.kind == FD_KIND_DIR) { sync_mutex_unlock(&v->lock); return FD_E_INVALID; }
  if (!exists && rc != FD_E_NOT_FOUND) { sync_mutex_unlock(&v->lock); return rc; }
  if (quota > 0) {
    var used: int64 = 0;
    rc = fd_entry_usage(v->db, owner, &used);
    if (rc != FD_OK) { sync_mutex_unlock(&v->lock); return rc; }
    if (exists && fd_entry_info_owner(&e) == owner) { used = used - e.size; }
    if (used + size > quota) { sync_mutex_unlock(&v->lock); return FD_E_QUOTA; }
  }
  rc = fd_mkdir_p(fd_disk_str(&pd));
  if (rc != FD_OK) { sync_mutex_unlock(&v->lock); return rc; }
  var st: FsStat;
  if (fs_lstat(fd_disk_str(&d), &st) == 0 && st.kind == FS_DIR) { sync_mutex_unlock(&v->lock); return FD_E_INVALID; }
  if (file_rename(fd_disk_str(&td), fd_disk_str(&d)) < 0) { sync_mutex_unlock(&v->lock); return FD_E_IO; }
  fd_sync_dir(fd_disk_str(&pd));
  if (exists) { rc = fd_entry_touch(v->db, vpath, size, sha256); }
  else { rc = fd_entry_add_hashed(v->db, vpath, FD_KIND_FILE, size, owner, sha256); }
  sync_mutex_unlock(&v->lock);
  return rc;
}

/// Opens a file entry for reading. A link or anything but a regular file on
/// disk is refused. *e gets the entry (its sha256 may be empty).
/// returns: FD_OK and *fd; FD_E_NOT_FOUND; FD_E_DENIED; FD_E_IO
export fn fd_vfs_open_read(v: FdVfs*, vpath: string, fd: int64*, e: FdEntryInfo*) -> int32 {
  if (v == 0 || fd == 0 || e == 0 || vpath.length == 0) { return FD_E_USAGE; }
  var d: FdDiskPath;
  if (!fd_disk_path(v, vpath, &d)) { return FD_E_INVALID; }
  sync_mutex_lock(&v->lock);
  var rc: int32 = fd_entry_get(v->db, vpath, e);
  if (rc != FD_OK || e->kind != FD_KIND_FILE) {
    sync_mutex_unlock(&v->lock);
    if (rc == FD_OK) { return FD_E_NOT_FOUND; }
    return rc;
  }
  var st: FsStat;
  if (fs_lstat(fd_disk_str(&d), &st) != 0) { sync_mutex_unlock(&v->lock); return FD_E_NOT_FOUND; }
  if (st.kind != FS_FILE) { sync_mutex_unlock(&v->lock); return FD_E_DENIED; }
  var f: int64 = file_open(fd_disk_str(&d), FILE_READ);
  sync_mutex_unlock(&v->lock);
  if (f < 0) { return FD_E_IO; }
  *fd = f;
  return FD_OK;
}

// Deepest directory level refresh descends into.
const FD_WALK_DEPTH: int32 = 32;

// Adds entries for what is on disk under `vdir` and is not in MeoDB yet, then
// goes into the subdirectories. Symbolic links and other special files are
// skipped, so the walk stays under the root. Called with the lock held.
fn fd_walk(v: FdVfs*, vdir: string, owner: string, depth: int32, added: int32*) -> int32 {
  if (depth > FD_WALK_DEPTH) { return FD_OK; }
  var dd: FdDiskPath;
  if (!fd_disk_path(v, vdir, &dd)) { return FD_E_INVALID; }
  var d: FsDir* = (FsDir*)malloc((int64)sizeof(FsDir));
  if (d == 0) { return FD_E_NOMEM; }
  if (fs_dir_open(fd_disk_str(&dd), d) != 0) { free((rawptr)d); return FD_E_IO; }
  var rc: int32 = FD_OK;
  var ent: FsDirEntry;
  var pbuf: uint8[520];
  while (rc == FD_OK) {
    var more: int64 = fs_dir_next(d, &ent);
    if (more < 0) { rc = FD_E_IO; break; }
    if (more == 0) { break; }
    if (ent.kind != FS_FILE && ent.kind != FS_DIR) { continue; }
    var name: string = ent.name;
    if (name.length == 0 || !fd_seg_ok(name)) { continue; }
    if (vdir.length == 0 && name == FD_VFS_TMP) { continue; }
    var n: int64 = (int64)vdir.length;
    if (n > 0) { n = n + 1; }
    if (n + (int64)name.length > (int64)FD_PATH_MAX) { continue; }
    if (vdir.length > 0) {
      memcpy((rawptr)&pbuf[0], (rawptr)vdir.chars, (int64)vdir.length);
      pbuf[(int64)vdir.length] = (uint8)'/';
    }
    memcpy((rawptr)&pbuf[n], (rawptr)name.chars, (int64)name.length);
    var vpath: string = str_from_bytes((cstring)&pbuf[0], n + (int64)name.length);
    var e: FdEntryInfo;
    rc = fd_entry_get(v->db, vpath, &e);
    if (rc == FD_E_NOT_FOUND) {
      var size: int64 = 0;
      var kind: int32 = FD_KIND_DIR;
      if (ent.kind == FS_FILE) {
        kind = FD_KIND_FILE;
        var dp: FdDiskPath;
        var st: FsStat;
        if (!fd_disk_path(v, vpath, &dp) || fs_lstat(fd_disk_str(&dp), &st) != 0) { rc = FD_E_IO; break; }
        size = st.size;
      }
      rc = fd_entry_add(v->db, vpath, kind, size, owner);
      if (rc == FD_OK) { *added = *added + 1; }
    } else if (rc == FD_OK && ((e.kind == FD_KIND_DIR) != (ent.kind == FS_DIR))) {
      continue;   // a file where the metadata says directory, or the reverse
    }
    if (rc == FD_OK && ent.kind == FS_DIR) {
      rc = fd_walk(v, vpath, owner, depth + 1, added);
    }
  }
  fs_dir_close(d);
  free((rawptr)d);
  return rc;
}

/// Adds metadata entries, owned by `owner`, for files and directories that are
/// on disk under the root but not in MeoDB. Entries already there are left
/// alone. *added (optional) gets the number of new entries.
/// returns: FD_OK; FD_E_IO; FD_E_DB
export fn fd_vfs_refresh(v: FdVfs*, owner: string, added: int32*) -> int32 {
  if (v == 0) { return FD_E_USAGE; }
  var n: int32 = 0;
  sync_mutex_lock(&v->lock);
  var rc: int32 = fd_walk(v, "", owner, 0, &n);
  sync_mutex_unlock(&v->lock);
  if (added != 0) { *added = n; }
  return rc;
}

// ---- tests (no database needed) ----

fn t_resolve(cwd: string, input: string, want: string) -> bool {
  var p: FdVPath;
  if (fd_vfs_resolve(cwd, input, &p) != FD_OK) { return false; }
  return fd_vpath_str(&p) == want;
}

@test fn t_resolve_basic() -> int32 {
  if (!t_resolve("/", "a.txt", "a.txt")) { return 1; }
  if (!t_resolve("/docs", "a.txt", "docs/a.txt")) { return 2; }
  if (!t_resolve("/docs", "/a.txt", "a.txt")) { return 3; }
  if (!t_resolve("/", "a//b/./c", "a/b/c")) { return 4; }
  if (!t_resolve("/a/b", "..", "a")) { return 5; }
  if (!t_resolve("/a/b", "../../x", "x")) { return 6; }
  if (!t_resolve("/", "/", "")) { return 7; }
  if (!t_resolve("/", "with space.txt", "with space.txt")) { return 8; }
  return 0;
}

@test fn t_resolve_traversal() -> int32 {
  var p: FdVPath;
  if (fd_vfs_resolve("/", "..", &p) != FD_E_TRAVERSAL) { return 1; }
  if (fd_vfs_resolve("/", "../etc/passwd", &p) != FD_E_TRAVERSAL) { return 2; }
  if (fd_vfs_resolve("/a", "../../x", &p) != FD_E_TRAVERSAL) { return 3; }
  if (fd_vfs_resolve("/", "/a/../../x", &p) != FD_E_TRAVERSAL) { return 4; }
  if (fd_vfs_resolve("/", "a\\b", &p) != FD_E_TRAVERSAL) { return 5; }
  if (fd_vfs_resolve("/", "", &p) != FD_E_INVALID) { return 6; }
  if (fd_vfs_resolve_or_cwd("/x", "", &p) != FD_OK || fd_vpath_str(&p) != "x") { return 7; }
  if (fd_vfs_resolve("/", ".freedrs-tmp/x", &p) != FD_E_INVALID) { return 8; }
  if (fd_vfs_resolve("/.freedrs-tmp", "x", &p) != FD_E_INVALID) { return 9; }
  if (!t_resolve("/", ".freedrs-tmpx", ".freedrs-tmpx")) { return 10; }
  return 0;
}
