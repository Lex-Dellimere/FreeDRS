// freedrs/client/conn: the client connection.
//
// A reader thread turns the socket into lines and queues them (mutex + condvar,
// std/sync). It swallows heartbeat answers: a line `PONG` and the `CMD_END` after
// it never reach the caller. A heartbeat thread sends `PING` every 5 s while the
// REPL is idle (never between a command and its reply, so it cannot land inside
// an upload) and drops the connection when a PING gets no PONG within 12 s.
//
// Callers: fd_conn_open, then fd_conn_send_line / fd_conn_next_line (blocking),
// fd_conn_busy(true) around a command and its reply, fd_conn_close.
// One connection per process (module globals).
//
// With fd_conn_use_tls the connection runs over TLS (mtls). The handshake is
// done in fd_conn_open, before the threads start. After that the reader reads
// the one MtlsStream while the heartbeat and REPL threads write to it; mtls
// allows that without a lock of ours. fd_conn_close stops the reader with
// mtls_stream_shutdown, joins both threads, then closes the stream.

import "std/mem";
import "std/conv";
import "std/time";
import "std/sync";
import "std/thread";
import "std/process";
import "std/io";
import "std/socket";
import "mtls/mtls";

const PING_EVERY_MS: int64 = 5000;
const PONG_WITHIN_MS: int64 = 12000;
const LINE_MAX: int64 = 25165824;

struct LineNode {
  next: LineNode*;
  len: int64;
  data: uint8*;
}

var g_sock: int64 = -1;
var g_lock: SyncMutex;        // queue, closed, pong state
var g_cond: SyncCond;
var g_send_lock: SyncMutex;   // sends, and the busy flag
var g_head: LineNode*;
var g_tail: LineNode*;
var g_closed: bool;
var g_busy: bool;
var g_swallow_end: bool;
var g_ping_sent_ms: int64;    // 0 = no PING waiting for its PONG
var g_heartbeat: bool;
var g_gen: int64;             // bumps on every open: old threads stop

var g_reader: int64;          // thread handles, joined by fd_conn_close
var g_hb: int64;

var g_use_tls: bool;
var g_tls_cfg: MtlsConfig;
var g_tls_roots: MtlsRoots;
var g_stream: MtlsStream;     // the open connection when g_tls_on
var g_tls_on: bool;
const HANDSHAKE_MS: int64 = 10000;

// ---- socket I/O, plain or TLS ----

// Sends n bytes (encrypted when TLS is on). false when the connection is gone.
fn net_send(p: uint8*, n: int64) -> bool {
  if (!g_tls_on) { return sock_send_all(g_sock, p, n) >= 0; }
  return mtls_stream_write(&g_stream, p, n) >= 0;
}

// Reads up to cap bytes like sock_recv: a count, 0 when the server closed, or a
// negative error. With TLS the bytes are decrypted. Only the reader thread
// calls this.
fn net_recv(buf: uint8*, cap: int64) -> int64 {
  if (!g_tls_on) { return sock_recv(g_sock, buf, cap); }
  return mtls_stream_read(&g_stream, buf, cap);
}

// Stops the connection so a blocked reader returns. Safe from any thread.
fn net_shutdown() {
  if (g_tls_on) { mtls_stream_shutdown(&g_stream); }
  else { sock_shutdown(g_sock, NET_SHUT_BOTH); }
}

// Runs the TLS handshake on the connected socket. false (with *msg) on failure.
fn tls_start(host: string, msg: string*) -> bool {
  memset((rawptr)&g_stream, 0, (int64)sizeof(MtlsStream));
  sock_set_timeout(g_sock, HANDSHAKE_MS, HANDSHAKE_MS);
  var rc: int32 = mtls_stream_client(&g_stream, g_sock, &g_tls_cfg, host);   // the socket stays ours
  sock_set_timeout(g_sock, 0, 0);
  if (rc != MTLS_OK) {
    var why: string = mtls_err_text(rc);
    if (g_stream.c != (MtlsConn*)0 && mtls_conn_cert_error(g_stream.c) != 0) {
      why = "{why}: {mtls_cv_text(mtls_conn_cert_error(g_stream.c))}";
    }
    *msg = "TLS handshake failed ({why})";
    mtls_stream_close(&g_stream);
    return false;
  }
  g_tls_on = true;
  return true;
}

// ---- queue ----

fn push_line(data: uint8*, len: int64) {
  var n: LineNode* = (LineNode*)calloc(1, (int64)sizeof(LineNode));
  if (n == 0) { return; }
  n->data = (uint8*)malloc(len + 1);
  if (n->data == 0) { free((rawptr)n); return; }
  if (len > 0) { memcpy((rawptr)n->data, (rawptr)data, len); }
  n->data[len] = (uint8)0;
  n->len = len;
  sync_mutex_lock(&g_lock);
  if (g_tail == 0) { g_head = n; } else { g_tail->next = n; }
  g_tail = n;
  sync_cond_signal(&g_cond);
  sync_mutex_unlock(&g_lock);
}

fn mark_closed(gen: int64) {
  sync_mutex_lock(&g_lock);
  if (gen == g_gen) { g_closed = true; }
  sync_cond_broadcast(&g_cond);
  sync_mutex_unlock(&g_lock);
}

// Handles heartbeat answers; true when the line was one and must be dropped.
fn swallow(data: uint8*, len: int64) -> bool {
  var s: string = str_from_bytes((cstring)data, len);
  sync_mutex_lock(&g_lock);
  var drop: bool = false;
  if (s == "PONG" && g_ping_sent_ms != 0) {
    g_ping_sent_ms = 0;
    g_swallow_end = true;
    drop = true;
  } else if (s == "CMD_END" && g_swallow_end) {
    g_swallow_end = false;
    drop = true;
  }
  sync_mutex_unlock(&g_lock);
  return drop;
}

fn reader_thread(param: cstring) -> uint32 {
  var gen: int64 = (int64)param;
  var cap: int64 = 65536;
  var buf: uint8* = (uint8*)malloc(cap);
  var len: int64 = 0;
  var scan: int64 = 0;
  while (buf != 0 && gen == g_gen) {
    var i: int64 = scan;
    var start: int64 = 0;
    while (i < len) {
      if (buf[i] == (uint8)10) {
        var end: int64 = i;
        if (end > start && buf[end - 1] == (uint8)13) { end = end - 1; }
        if (!swallow(buf + start, end - start)) { push_line(buf + start, end - start); }
        start = i + 1;
      }
      i = i + 1;
    }
    if (start > 0) {
      if (len > start) { memmove((rawptr)buf, (rawptr)(buf + start), len - start); }
      len = len - start;
    }
    scan = len;
    if (cap - len < 4096) {
      if (cap >= LINE_MAX + 65536) { break; }
      cap = cap * 2;
      buf = (uint8*)realloc((rawptr)buf, cap);
      if (buf == 0) { break; }
    }
    var n: int64 = net_recv(buf + len, cap - len);
    if (n == -(int64)NET_EINTR) { continue; }
    if (n <= 0) { break; }
    len = len + n;
  }
  if (buf != 0) { free((rawptr)buf); }
  mark_closed(gen);
  return 0;
}

fn heartbeat_thread(param: cstring) -> uint32 {
  var gen: int64 = (int64)param;
  var last_ping: int64 = time_mono_ms();
  while (gen == g_gen) {
    time_sleep_ms(50);
    if (gen != g_gen) { break; }
    var now: int64 = time_mono_ms();
    sync_mutex_lock(&g_lock);
    var waiting: int64 = g_ping_sent_ms;
    var closed: bool = g_closed;
    sync_mutex_unlock(&g_lock);
    if (closed) { break; }
    if (waiting != 0 && now - waiting > PONG_WITHIN_MS) {
      println_err("freedrs: no PONG from the server for 12 s, connection lost");
      sock_shutdown(g_sock, NET_SHUT_BOTH);   // the reader sees the end; fd_conn_close finishes the job
      break;
    }
    if (waiting == 0 && now - last_ping >= PING_EVERY_MS) {
      sync_mutex_lock(&g_send_lock);
      if (!g_busy) {
        sync_mutex_lock(&g_lock);
        g_ping_sent_ms = now;
        sync_mutex_unlock(&g_lock);
        net_send((uint8*)"PING\n".chars, 5);
        last_ping = now;
      }
      sync_mutex_unlock(&g_send_lock);
    }
  }
  return 0;
}

// ---- API ----

/// Makes later connections use TLS. The server's certificate is checked
/// against the roots in the PEM file `ca_path`, or against the system roots
/// when it is empty, and must be valid for the host name given to fd_conn_open.
/// Call once before fd_conn_open. returns: true, or false with *msg set.
export fn fd_conn_use_tls(ca_path: string, msg: string*) -> bool {
  mtls_roots_init(&g_tls_roots);
  if (ca_path.length > 0) {
    var added: int32 = mtls_roots_add_file(&g_tls_roots, ca_path);
    if (added < 0) { *msg = "cannot read {ca_path}: {mtls_err_text(added)}"; return false; }
    if (added == 0) { *msg = "no certificates in {ca_path}"; return false; }
  } else if (mtls_roots_load_system(&g_tls_roots) <= 0) {
    *msg = "no system CA certificates found; use --ca FILE";
    return false;
  }
  mtls_config_init(&g_tls_cfg);
  g_tls_cfg.roots = &g_tls_roots;
  g_use_tls = true;
  return true;
}

/// Connects (host name or dotted quad) and starts the reader, and the heartbeat
/// when `heartbeat` is true. returns: true, or false with *msg set.
export fn fd_conn_open(host: string, port: int32, heartbeat: bool, msg: string*) -> bool {
  match (tcp_connect(host, port, 5000)) {
    case Ok(fd): { g_sock = fd; }
    case Err(e): { *msg = e.message; return false; }
  }
  g_tls_on = false;
  if (g_use_tls && !tls_start(host, msg)) {
    sock_close(g_sock);
    g_sock = -1;
    return false;
  }
  sync_mutex_lock(&g_lock);
  g_gen = g_gen + 1;
  g_head = 0;
  g_tail = 0;
  g_closed = false;
  g_swallow_end = false;
  g_ping_sent_ms = 0;
  g_busy = false;
  var gen: int64 = g_gen;
  sync_mutex_unlock(&g_lock);
  g_reader = CreateThread(0, 0, &reader_thread, (cstring)gen, 0, 0);
  if (g_reader == 0) { net_close(); *msg = "cannot start the reader thread"; return false; }
  g_hb = 0;
  g_heartbeat = heartbeat;
  if (heartbeat) { g_hb = CreateThread(0, 0, &heartbeat_thread, (cstring)gen, 0, 0); }
  return true;
}

/// Sends `line` and a newline. false when the connection is gone.
export fn fd_conn_send_line(line: string) -> bool {
  sync_mutex_lock(&g_send_lock);
  var ok: bool = net_send((uint8*)line.chars, (int64)line.length)
              && net_send((uint8*)"\n".chars, 1);
  sync_mutex_unlock(&g_send_lock);
  return ok;
}

/// Sends raw bytes (an upload body). false when the connection is gone.
export fn fd_conn_send_bytes(p: uint8*, n: int64) -> bool {
  sync_mutex_lock(&g_send_lock);
  var ok: bool = net_send(p, n);
  sync_mutex_unlock(&g_send_lock);
  return ok;
}

/// True while a command is in flight (no heartbeat is sent). Set it before
/// sending a command and clear it after the last reply line.
export fn fd_conn_busy(on: bool) {
  sync_mutex_lock(&g_send_lock);
  g_busy = on;
  sync_mutex_unlock(&g_send_lock);
}

/// Waits for the next line. The returned heap string must be freed with
/// fd_conn_free_line. false: the connection closed and nothing is queued.
export fn fd_conn_next_line(out: string*) -> bool {
  sync_mutex_lock(&g_lock);
  while (g_head == 0 && !g_closed) { sync_cond_wait(&g_cond, &g_lock); }
  var n: LineNode* = g_head;
  if (n != 0) {
    g_head = n->next;
    if (g_head == 0) { g_tail = 0; }
  }
  sync_mutex_unlock(&g_lock);
  if (n == 0) { return false; }
  *out = str_from_bytes((cstring)n->data, n->len);
  free((rawptr)n);   // the node only; the text stays valid until fd_conn_free_line
  return true;
}

export fn fd_conn_free_line(s: string) {
  free((rawptr)s.chars);
}

// Closes the stream (close_notify, best effort) and the socket. No thread may
// be using the connection.
fn net_close() {
  if (g_tls_on) {
    mtls_stream_close(&g_stream);
    g_tls_on = false;
  }
  if (g_sock >= 0) {
    sock_close(g_sock);
    g_sock = -1;
  }
}

/// Closes the connection: stops the reader, joins the reader and heartbeat
/// threads, then closes the stream and the socket.
export fn fd_conn_close() {
  if (g_sock < 0) { return; }
  sync_mutex_lock(&g_lock);
  g_gen = g_gen + 1;
  sync_mutex_unlock(&g_lock);
  net_shutdown();
  if (g_reader != 0) { thread_join_infinite(g_reader); thread_close(g_reader); g_reader = 0; }
  if (g_hb != 0) { thread_join_infinite(g_hb); thread_close(g_hb); g_hb = 0; }
  net_close();
}
