// freedrs_client: command line client.
//
//   freedrs_client [HOST[:PORT]] [--guest | --user NAME [--pass PASSWORD]]
//                  [--tls [--ca FILE]]
//
// HOST defaults to 127.0.0.1, PORT to 5555. Without --user/--guest it asks
// whether to log in, sign up or enter as guest. Passwords are typed with echo
// off when stdin is a terminal. Then a prompt: every line is sent
// to the server and the reply printed up to CMD_END. With --tls the connection
// is encrypted and the server's certificate is checked against the roots in
// the --ca file, or the system roots without it. Local commands:
//   status                                       connection state
//   upload [--lz4] [--resume] <local> [remote]   stream a local file up
//   download [--lz4] [--resume] <remote> [local] stream a file down
//   quit / exit                                  leave
// Transfers go a piece at a time (client/xfer.mettle) and show their progress
// when stdout is a terminal. --lz4 compresses on the wire; --resume goes on
// from where a broken transfer stopped. A PING goes out every 5 s while idle;
// 12 s without PONG ends the session.

import "std/io";
import "std/mem";
import "std/conv";
import "std/process";
import "std/term";
import "std/term_os";
import "std/socket";
import "args/args";
import "freedrs/version";
import "freedrs/client/conn";
import "freedrs/client/xfer";

var g_line: uint8[2048];
var g_user: string = "";
var g_host: string = "127.0.0.1";
var g_port: int32 = 5555;

// One line from stdin without the newline. false at end of input.
fn read_input(prompt: string, out: string*) -> bool {
  print(prompt);
  if (fgets((cstring)&g_line[0], 2048, get_stdin()) == 0) { return false; }
  var n: int64 = 0;
  while (n < 2048 && g_line[n] != (uint8)0) { n = n + 1; }
  while (n > 0 && (g_line[n - 1] == (uint8)10 || g_line[n - 1] == (uint8)13)) { n = n - 1; }
  *out = str_from_bytes((cstring)&g_line[0], n);
  return true;
}

// Like read_input, for a password: echo is off when stdin is a terminal.
// A pipe or file is read as usual. Ctrl-C at the prompt: term_read_secret puts
// the terminal back first, then the program gets SIGINT and ends, so echo is
// never left off.
fn read_secret(prompt: string, out: string*) -> bool {
  if (!term_is_tty(0)) { return read_input(prompt, out); }
  var n: int64 = term_read_secret(prompt, &g_line[0], 2047);
  if (n < 0) { return false; }
  *out = str_from_bytes((cstring)&g_line[0], n);
  return true;
}

// The first word and the rest of a line.
struct Words {
  word: string;
  rest: string;
}

fn split_word(s: string) -> Words {
  var w: Words;
  var n: int64 = (int64)s.length;
  var i: int64 = 0;
  while (i < n && is_space((char)s.chars[i])) { i = i + 1; }
  var start: int64 = i;
  while (i < n && !is_space((char)s.chars[i])) { i = i + 1; }
  w.word = str_slice(s, start, i - start);
  while (i < n && is_space((char)s.chars[i])) { i = i + 1; }
  w.rest = str_slice(s, i, n - i);
  return w;
}

// Next line from the server; false (with a message) when the connection closed.
fn next(out: string*) -> bool {
  if (fd_conn_next_line(out)) { return true; }
  println_err("freedrs: connection closed by the server");
  return false;
}

// Prints reply lines up to CMD_END. false: connection lost.
fn print_reply() -> bool {
  var line: string;
  while (true) {
    if (!next(&line)) { return false; }
    if (line == "CMD_END") { fd_conn_free_line(line); return true; }
    println(line);
    fd_conn_free_line(line);
  }
  return true;
}

// Leading --lz4 and --resume; false (usage printed) for anything else.
fn transfer_options(args: string, o: FdXferOpts*, rest: string*, usage: string) -> bool {
  memset((rawptr)o, 0, (int64)sizeof(FdXferOpts));
  o->progress = term_is_tty(1);
  var r: string = args;
  while (true) {
    var w: Words = split_word(r);
    if (str_starts_with(w.word, "--") == 0) { break; }
    if (w.word == "--lz4") { o->lz4 = true; }
    else if (w.word == "--resume") { o->resume = true; }
    else { println(usage); return false; }
    r = w.rest;
  }
  *rest = r;
  return true;
}

fn do_upload(args: string) -> bool {
  var usage: string = "ERROR: Usage: upload [--lz4] [--resume] <local-file-path> [remote-path]";
  var o: FdXferOpts;
  var rest: string = "";
  if (!transfer_options(args, &o, &rest, usage)) { return true; }
  var w: Words = split_word(rest);
  if (w.word.length == 0) { println(usage); return true; }
  var st: FdXferStats;
  fd_conn_busy(true);
  var rc: int32 = fd_client_upload(w.word, w.rest, &o, &st);
  fd_conn_busy(false);
  return rc >= 0;
}

fn do_download(args: string) -> bool {
  var usage: string = "ERROR: Usage: download [--lz4] [--resume] <remote-file-path> [local-path]";
  var o: FdXferOpts;
  var rest: string = "";
  if (!transfer_options(args, &o, &rest, usage)) { return true; }
  var w: Words = split_word(rest);
  if (w.word.length == 0) { println(usage); return true; }
  var st: FdXferStats;
  fd_conn_busy(true);
  var rc: int32 = fd_client_download(w.word, w.rest, &o, &st);
  fd_conn_busy(false);
  if (rc < 0) { println_err("freedrs: connection lost; `download --resume` goes on from here"); }
  return rc >= 0;
}

// ---- login ----

// Sends the login/signup/guest line and reads the server's answer.
// 1 = logged in, 0 = refused (message printed), -1 = connection lost,
// 2 = signed up (the server closes; reconnect and log in).
fn authenticate(cmd: string) -> int32 {
  if (!fd_conn_send_line(cmd)) { return -1; }
  var line: string;
  if (!next(&line)) { return -1; }
  var res: int32 = 0;
  if (str_starts_with(line, "SUCCESS: User registered") != 0) { res = 2; }
  else if (str_starts_with(line, "SUCCESS") != 0) { res = 1; }
  println(line);
  fd_conn_free_line(line);
  if (res == 1) {
    if (!next(&line)) { return -1; }   // "Type 'help' ..."
    println(line);
    fd_conn_free_line(line);
  }
  return res;
}

fn connect_and_greet() -> bool {
  var msg: string = "";
  if (!fd_conn_open(g_host, g_port, true, &msg)) {
    println_err("freedrs: cannot connect to {g_host}:{g_port}: {msg}");
    return false;
  }
  var line: string;
  var i: int32 = 0;
  while (i < 2) {
    if (!next(&line)) { return false; }
    println(line);
    fd_conn_free_line(line);
    i = i + 1;
  }
  return true;
}

// A heap copy of s (g_line is reused by the next read).
fn dup(s: string) -> string {
  var p: uint8* = (uint8*)malloc((int64)s.length + 1);
  if (s.length > 0) { memcpy((rawptr)p, (rawptr)s.chars, (int64)s.length); }
  return str_from_bytes((cstring)p, (int64)s.length);
}

// Asks for a user name and password. false at end of input.
fn ask_credentials(creds: Creds*) -> bool {
  var tmp: string;
  if (!read_input("Username: ", &tmp)) { return false; }
  creds->user = dup(tmp);
  if (!read_secret("Password: ", &tmp)) { return false; }
  creds->pass = dup(tmp);
  return true;
}

struct Creds {
  user: string;
  pass: string;
}

// Interactive: ask how to authenticate (or use the command line). false: give up.
fn prompt_auth(first: Creds*, guest_first: bool) -> bool {
  var creds: Creds = *first;
  var guest: bool = guest_first;
  var tries: int32 = 0;
  while (tries < 5) {
    tries = tries + 1;
    if (!connect_and_greet()) { return false; }
    // The server answers PING only after login, so no heartbeat while the
    // user is typing credentials.
    fd_conn_busy(true);
    var mode: string = "l";
    if (guest) {
      mode = "g";
    } else if (creds.user.length > 0 && creds.pass.length == 0) {
      var pw: string;
      if (!read_secret("Password for {creds.user}: ", &pw)) { return false; }
      creds.pass = dup(pw);
    } else if (creds.user.length == 0) {
      var ans: string;
      if (!read_input("[l]ogin, [s]ignup or [g]uest? ", &ans)) { return false; }
      mode = dup(ans);
      if (!(mode == "g" || mode == "guest")) {
        if (!ask_credentials(&creds)) { return false; }
      }
    }
    var cmd: string = "guest";
    if (mode == "s" || mode == "signup") { cmd = "signup {creds.user} {creds.pass}"; }
    else if (mode == "l" || mode == "login") { cmd = "login {creds.user} {creds.pass}"; }
    var r: int32 = authenticate(cmd);
    if (r == 1) {
      g_user = "guest";
      if (creds.user.length > 0 && mode != "g" && mode != "guest") { g_user = creds.user; }
      fd_conn_busy(false);
      return true;
    }
    if (r < 0) { return false; }
    fd_conn_close();
    guest = false;
    if (r == 2) {
      // signed up: the server closed the connection; connect again and log in
      println("Signed up. Logging in...");
    } else {
      creds.user = "";   // refused: ask again
      creds.pass = "";
    }
  }
  return false;
}

// ---- the REPL ----

fn repl() -> int32 {
  var line: string;
  while (true) {
    if (!read_input("{g_user}@{g_host}> ", &line)) { break; }
    var t: string = str_trim(line);
    if (t.length == 0) { continue; }
    var w: Words = split_word(t);
    var verb: string = "";
    var vb: uint8[16];
    if (w.word.length < 16) {
      var i: int64 = 0;
      while (i < (int64)w.word.length) { vb[i] = (uint8)to_lower((char)w.word.chars[i]); i = i + 1; }
      verb = str_from_bytes((cstring)&vb[0], (int64)w.word.length);
    }
    var ok: bool = true;
    if (verb == "status") {
      println("Connected to {g_host}:{g_port} as {g_user}");
    } else if (verb == "upload") {
      ok = do_upload(w.rest);
    } else if (verb == "download") {
      ok = do_download(w.rest);
    } else {
      fd_conn_busy(true);
      ok = fd_conn_send_line(t);
      if (ok) { ok = print_reply(); }
      fd_conn_busy(false);
      if (verb == "quit" || verb == "exit") { break; }
    }
    if (!ok) { return 1; }
  }
  fd_conn_send_line("quit");
  fd_conn_close();
  return 0;
}

fn main() -> int32 {
  var a: Args;
  args_init(&a, "freedrs_client", "FreeDRS command line client");
  args_version(&a, FD_VERSION);
  var hostport: string = "";
  args_pos_opt(&a, &hostport, "HOST[:PORT]", "", "server to connect to (default: 127.0.0.1:5555)");
  var guest: bool = false;
  args_flag(&a, &guest, 0, "guest", "enter as a guest");
  var user: string = "";
  args_str(&a, &user, 0, "user", "", "log in as this user");
  args_metavar(&a, "NAME");
  var pass: string = "";
  args_str(&a, &pass, 0, "pass", "", "the password for --user (asked for when left out)");
  args_metavar(&a, "PASSWORD");
  var use_tls: bool = false;
  args_flag(&a, &use_tls, 0, "tls", "connect over TLS");
  var ca: string = "";
  args_str(&a, &ca, 0, "ca", "", "PEM file with the CA certificates to trust (default: the system roots); needs --tls");
  args_metavar(&a, "FILE");
  var code: int32 = args_run(&a);
  if (code >= 0) { return code; }

  if (guest && user.length > 0) {
    println_err("freedrs_client: use either --guest or --user");
    return 2;
  }
  if (pass.length > 0 && user.length == 0) {
    println_err("freedrs_client: --pass needs --user");
    return 2;
  }
  if (ca.length > 0 && !use_tls) {
    println_err("freedrs_client: --ca needs --tls");
    return 2;
  }
  if (hostport.length > 0) {
    match (net_split_host_port(hostport, 5555)) {
      case Ok(hp): { g_host = hp.host; g_port = hp.port; }
      case Err(why): { println_err("freedrs_client: bad address: {why}"); return 2; }
    }
  }
  if (use_tls) {
    var msg: string = "";
    if (!fd_conn_use_tls(ca, &msg)) {
      println_err("freedrs_client: {msg}");
      return 2;
    }
  }
  var creds: Creds;
  creds.user = user;
  creds.pass = pass;
  if (!prompt_auth(&creds, guest)) { return 1; }
  return repl();
}
