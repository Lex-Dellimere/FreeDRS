// freedrs_server: the FreeDRS file server.
//
//   freedrs_server [--config FILE] [--port N] [--root DIR] [--meodb IP:PORT]
//                  [--tls-cert FILE --tls-key FILE]
//
// Reads server_config.json (std/file) when --config is given, or when
// ./server_config.json exists; defaults otherwise (config/config.mettle).
// Connects to the meodb server, opens auth and the VFS, then accepts
// connections with alph: an acceptor actor and one session actor per client
// (serve.mettle, session.mettle). With --tls-cert and --tls-key clients must
// use TLS; without them the server speaks plain TCP.
//
// Startup problems, the listening address and the shutdown go to the log
// package. Set METTLE_LOG to change the level, for example METTLE_LOG=debug.

import "std/io";
import "std/fs";
import "std/conv";
import "args/args";
import "log/log";
import "mtls/mtls";
import "freedrs/version";
import "freedrs/status";
import "freedrs/config/config";
import "freedrs/auth/auth";
import "freedrs/db/store";
import "freedrs/vfs/vfs";
import "freedrs/server/state";
import "freedrs/server/tls";
import "freedrs/server/serve";

fn main() -> int32 {
  var a: Args;
  args_init(&a, "freedrs_server", "FreeDRS file server");
  args_version(&a, FD_VERSION);
  var config_path: string = "";
  args_str(&a, &config_path, 0, "config", "", "read settings from this JSON file (default: ./server_config.json if it exists)");
  args_metavar(&a, "FILE");
  var port_arg: string = "";
  args_str(&a, &port_arg, 0, "port", "", "TCP port to listen on (default: 5555)");
  args_metavar(&a, "N");
  var root_arg: string = "";
  args_str(&a, &root_arg, 0, "root", "", "directory that holds the files (default: dfs_root)");
  args_metavar(&a, "DIR");
  var meodb_arg: string = "";
  args_str(&a, &meodb_arg, 0, "meodb", "", "address of the meodb server (default: 127.0.0.1:5490)");
  args_metavar(&a, "IP:PORT");
  var tls_cert: string = "";
  args_str(&a, &tls_cert, 0, "tls-cert", "", "certificate chain (PEM) to serve over TLS; needs --tls-key");
  args_metavar(&a, "FILE");
  var tls_key: string = "";
  args_str(&a, &tls_key, 0, "tls-key", "", "private key (PEM) for --tls-cert");
  args_metavar(&a, "FILE");
  var code: int32 = args_run(&a);
  if (code >= 0) { return code; }

  fd_log_init();
  var lg: LogLogger* = fd_log();
  if ((tls_cert.length > 0) != (tls_key.length > 0)) {
    println_err("freedrs_server: --tls-cert and --tls-key go together");
    return 2;
  }

  fd_config_defaults(&g_cfg);
  if (config_path.length > 0) {
    var rc: int32 = fd_config_load(&g_cfg, config_path);
    if (rc != FD_OK) {
      log_error(lg, "cannot load config", log_str("path", config_path), log_str("error", fd_status_text(rc)));
      return 2;
    }
  } else if (fs_exists("server_config.json")) {
    var rc: int32 = fd_config_load(&g_cfg, "server_config.json");
    if (rc != FD_OK) {
      log_error(lg, "bad server_config.json", log_str("error", fd_status_text(rc)));
      return 2;
    }
  }
  if (port_arg.length > 0 && fd_config_set_port(&g_cfg, str_to_i64_or(port_arg, -1)) != FD_OK) {
    log_error(lg, "bad --port", log_str("port", port_arg));
    return 2;
  }
  if (root_arg.length > 0 && fd_config_set_root(&g_cfg, root_arg) != FD_OK) {
    log_error(lg, "bad --root", log_str("root", root_arg));
    return 2;
  }
  if (meodb_arg.length > 0 && fd_config_set_meodb(&g_cfg, meodb_arg) != FD_OK) {
    log_error(lg, "bad --meodb address", log_str("meodb", meodb_arg));
    return 2;
  }
  if (tls_cert.length > 0) {
    var trc: int32 = fd_tls_enable(tls_cert, tls_key);
    if (trc != MTLS_OK) {
      log_error(lg, "cannot load the TLS certificate or key", log_str("cert", tls_cert), log_str("key", tls_key),
                log_str("error", mtls_err_text(trc)));
      return 2;
    }
  }

  var rc: int32 = fd_db_open(&g_db, fd_config_meodb(&g_cfg), "");
  if (rc != FD_OK) {
    log_error(lg, "cannot reach meodb", log_str("meodb", fd_config_meodb(&g_cfg)), log_str("error", fd_status_text(rc)));
    return 1;
  }
  fd_roles_seed(&g_db);
  rc = fd_auth_init(&g_auth, &g_db);
  if (rc != FD_OK) {
    log_error(lg, "auth init failed", log_str("error", fd_status_text(rc)));
    return 1;
  }
  rc = fd_vfs_init(&g_vfs, &g_db, fd_config_root(&g_cfg));
  if (rc != FD_OK) {
    log_error(lg, "cannot open root", log_str("root", fd_config_root(&g_cfg)), log_str("error", fd_status_text(rc)));
    return 1;
  }
  rc = fd_vfs_refresh(&g_vfs, fd_config_admin_user(&g_cfg), 0);
  if (rc != FD_OK) {
    log_error(lg, "cannot scan root", log_str("root", fd_config_root(&g_cfg)), log_str("error", fd_status_text(rc)));
    return 1;
  }

  var port: int64 = 0;
  var msg: string = "";
  if (!fd_server_start(g_cfg.port, &port, &msg)) {
    log_error(lg, "cannot listen", log_int("port", g_cfg.port), log_str("error", msg));
    return 1;
  }
  log_info(lg, "listening", log_int("port", port), log_str("root", fd_config_root(&g_cfg)),
           log_str("meodb", fd_config_meodb(&g_cfg)), log_bool("tls", g_tls_on));
  var exit_code: int64 = fd_server_wait();
  log_info(lg, "server stopped", log_int("code", exit_code));
  fd_db_close(&g_db);
  log_shutdown();
  return (int32)exit_code;
}
