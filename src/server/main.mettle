// freedrs_server: the FreeDRS file server.
//
//   freedrs_server [--config FILE] [--port N] [--root DIR] [--meodb IP:PORT]
//
// Reads server_config.json (std/file) when --config is given, or when
// ./server_config.json exists; defaults otherwise (config/config.mettle).
// Connects to the meodb server, opens auth and the VFS, then accepts
// connections with alph: an acceptor actor and one session actor per client
// (serve.mettle, session.mettle).

import "std/io";
import "std/mem";
import "std/conv";
import "std/dir";
import "freedrs/status";
import "freedrs/config/config";
import "freedrs/auth/auth";
import "freedrs/db/store";
import "freedrs/vfs/vfs";
import "freedrs/server/state";
import "freedrs/server/serve";

fn main(argc: int32, argv: cstring*) -> int32 {
  fd_config_defaults(&g_cfg);
  var config_path: string = "";
  var port_arg: int64 = -1;
  var root_arg: string = "";
  var meodb_arg: string = "";
  var i: int32 = 1;
  while (i < argc) {
    var arg: string = str_from_cstr(argv[i]);
    if (arg == "--config" && i + 1 < argc) { config_path = str_from_cstr(argv[i + 1]); }
    else if (arg == "--port" && i + 1 < argc) { port_arg = str_to_i64_or(str_from_cstr(argv[i + 1]), -1); }
    else if (arg == "--root" && i + 1 < argc) { root_arg = str_from_cstr(argv[i + 1]); }
    else if (arg == "--meodb" && i + 1 < argc) { meodb_arg = str_from_cstr(argv[i + 1]); }
    else {
      println_err("usage: freedrs_server [--config FILE] [--port N] [--root DIR] [--meodb IP:PORT]");
      return 2;
    }
    i = i + 2;
  }
  if (config_path.length > 0) {
    var rc: int32 = fd_config_load(&g_cfg, config_path);
    if (rc != FD_OK) {
      println_err("freedrs_server: cannot load {config_path}: {fd_status_text(rc)}");
      return 2;
    }
  } else if (file_exists("server_config.json") != 0) {
    var rc: int32 = fd_config_load(&g_cfg, "server_config.json");
    if (rc != FD_OK) {
      println_err("freedrs_server: bad server_config.json: {fd_status_text(rc)}");
      return 2;
    }
  }
  if (port_arg >= 0 && fd_config_set_port(&g_cfg, port_arg) != FD_OK) {
    println_err("freedrs_server: bad --port");
    return 2;
  }
  if (root_arg.length > 0 && fd_config_set_root(&g_cfg, root_arg) != FD_OK) {
    println_err("freedrs_server: bad --root");
    return 2;
  }
  if (meodb_arg.length > 0 && fd_config_set_meodb(&g_cfg, meodb_arg) != FD_OK) {
    println_err("freedrs_server: bad --meodb address");
    return 2;
  }

  var rc: int32 = fd_db_open(&g_db, fd_config_meodb(&g_cfg), "");
  if (rc != FD_OK) {
    println_err("freedrs_server: cannot reach meodb at {fd_config_meodb(&g_cfg)}: {fd_status_text(rc)}");
    return 1;
  }
  fd_roles_seed(&g_db);
  rc = fd_auth_init(&g_auth, &g_db);
  if (rc != FD_OK) {
    println_err("freedrs_server: auth init failed: {fd_status_text(rc)}");
    return 1;
  }
  rc = fd_vfs_init(&g_vfs, &g_db, fd_config_root(&g_cfg));
  if (rc != FD_OK) {
    println_err("freedrs_server: cannot open root {fd_config_root(&g_cfg)}: {fd_status_text(rc)}");
    return 1;
  }

  var port: int64 = 0;
  var msg: string = "";
  if (!fd_server_start(g_cfg.port, &port, &msg)) {
    println_err("freedrs_server: cannot listen on port {g_cfg.port}: {msg}");
    return 1;
  }
  println("freedrs_server: listening on port {port}, root {fd_config_root(&g_cfg)}");
  var code: int64 = fd_server_wait();
  fd_db_close(&g_db);
  return (int32)code;
}
