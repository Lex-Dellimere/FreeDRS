// freedrs/server/session: one alph actor per client connection.
//
// The acceptor (serve.mettle) gives each accepted socket to a new session actor
// (ALPH_TAG_IO_GIVEN); from then on the session owns the IO handle, reads it
// when armed (ALPH_TAG_IO), and writes through an output queue (AlphOutq), so no
// call blocks on the socket. A session that sees a read or write fail, or the
// peer close, ends; the runtime closes the handle when the actor exits.
//
// States:
//   AUTH      greeting; `login`, `signup` or `guest`; no CMD_END.
//   CMD       one line in, reply lines and CMD_END out (cmds.mettle).
//   UP_SIZE   after `upload` and READY: the `SIZE <n>` line.
//   UP_DATA   after OFFSET: base64 data lines, one job each, until `EOF <hash>`.
//   DOWNLOAD  after FILE_DATA: the session asks the pool for the next lines
//             only once its output (and mtls's) is below DL_LOW, so a slow
//             reader holds the server to a few MB. Input waits until it ends.
//
// While a transfer runs the session ticks (alph_send_after): no progress for
// g_xfer_stall_ms ends the session. A protocol error in a transfer (a bad
// line, data beyond SIZE) gets an ERROR line and CMD_END, then the session
// closes. The exit hook detaches the session's transfers (xfer.mettle), so a
// session that ends any way leaves no open file or temp file behind, except a
// partial upload kept for resume.
//
// `kick` sends the target session actor a TAG_KICK message (state.mettle keeps
// the pid); it ends itself. `shutdown` asks the node to stop in order.
//
// With TLS on (g_tls_on) the session owns an MtlsNb (mtls non-blocking) on the
// same socket. The handshake runs in the actor one readiness message at a time
// (mtls_nb_pump), so no scheduler thread waits for it; the greeting is sent once
// it is done. Reads and writes go through mtls_nb_read / mtls_nb_write, and the
// socket is armed for what mtls_nb_wants asks. An exit hook closes the TLS
// state on every exit, a crash included; alph still closes the socket.
//
// Nothing in a handler blocks. Logins, signups, every command (meodb, Argon2id,
// VFS file IO) and the end of an upload run as jobs on alph's worker pool
// (jobs.mettle, alph_offload): the session sends a copy of what the job needs,
// stops running lines while the job is out (st->job), and applies the answer
// (ALPH_TAG_DONE: the new FdSess and the reply text) when it arrives. Each
// upload data line and each batch of download lines is one job too.

import "std/mem";
import "std/conv";
import "std/arena";
import "std/strbuf";
import "std/sync";
import "std/time";
import "alph/alph";
import "log/log";
import "mtls/mtls";
import "freedrs/status";
import "freedrs/auth/auth";
import "freedrs/db/store";
import "freedrs/server/state";
import "freedrs/server/cmds";
import "freedrs/server/jobs";
import "freedrs/server/xfer";

const MODE_AUTH: int32 = 0;
const MODE_CMD: int32 = 1;
const MODE_UP_SIZE: int32 = 2;
const MODE_UP_DATA: int32 = 3;
const MODE_DOWNLOAD: int32 = 4;

const RBUF_START: int64 = 65536;
/// Longest line accepted, in bytes (a data line is at most FD_LINE_MAX).
const LINE_MAX: int64 = 131072;
/// A download asks for more lines once less than this waits to be sent.
const DL_LOW: int64 = 1048576;
/// The answers to `upload`: the most raw bytes a data line may carry
/// (FD_CHUNK_MAX), and whether LZ4 is on.
const READY: string = "READY: 65536\n";
const READY_LZ4: string = "READY: 65536 lz4\n";

/// How long a job may take before the session answers with an error.
const JOB_TIMEOUT_MS: int64 = 120000;

const GREETING: string = "=== Distributed File System ===\nAvailable: login <user> <pass> OR signup <user> <pass> OR guest\n";
const HELP_PROMPT: string = "Type 'help' for available commands\n";

struct FdSession {
  sess: FdSess;
  h: int64;        // the IO handle of the client socket
  ctx: AlphCtx*;   // valid only inside the current handler call
  out: AlphOutq;
  pool: int64;     // the worker pool's pid
  job: int64;      // ref of the job in flight, or 0
  job_kind: int32;
  mode: int32;
  closing: bool;   // leave once the output is written
  broken: bool;    // the output queue overflowed
  shutting: bool;  // the `shutdown` command ran
  registered: bool;
  rbuf: uint8*;
  rlen: int64;
  rcap: int64;
  rstart: int64;
  rscan: int64;
  xfer: int64;         // the transfer in progress, or 0
  x_last: int64;       // mono ms of its last progress
  x_left: int64;       // output waiting at the last settle (download progress)
  tick_gen: int64;     // the tick that counts; older ones are dropped
  ticking: bool;
  tls: MtlsNb;
  tls_on: bool;        // tls is started (the exit hook closes it)
  tls_ready: bool;     // the handshake is done and the greeting queued
  why: string;         // how the session ended, for the log
}

// ---- output ----

const OUT_LIMIT: int64 = 8388608;
/// Message to a session: end it (kick).
export const TAG_KICK: int64 = ALPH_TAG_USER;
/// Message a session sends itself: read again (TLS keeps decrypted bytes that
/// the socket will not announce).
const TAG_MORE: int64 = ALPH_TAG_USER + 1;
/// Message a session sends itself during a transfer: check for a stall.
const TAG_TICK: int64 = ALPH_TAG_USER + 2;

// The most output (outq plus mtls) and heap a downloading session has held,
// for the tests.
var g_peak_lock: SyncMutex;
var g_peak_out: int64 = 0;
var g_peak_heap: int64 = 0;

/// The most output bytes waiting, and heap bytes, any downloading session has
/// held since the last reset.
export fn fd_session_peaks(out: int64*, heap: int64*) {
  sync_mutex_lock(&g_peak_lock);
  *out = g_peak_out;
  *heap = g_peak_heap;
  sync_mutex_unlock(&g_peak_lock);
}

export fn fd_session_peaks_reset() {
  sync_mutex_lock(&g_peak_lock);
  g_peak_out = 0;
  g_peak_heap = 0;
  sync_mutex_unlock(&g_peak_lock);
}

/// With TLS, output goes from the queue into mtls in pieces of this size, and
/// only while mtls holds less than TLS_QUEUE unsent bytes (mtls limits its own
/// queue to 1 MiB).
const TLS_CHUNK: int64 = 65536;
const TLS_QUEUE: int64 = 262144;

// A TLS call failed (rc is an mtls error code): logs it and ends the session.
fn tls_fail(st: FdSession*, rc: int32) {
  if (st->broken) { return; }
  st->broken = true;
  if (!st->tls_ready && rc == MTLS_E_EOF) {
    log_warn(fd_log(), "TLS handshake failed, client left", log_int("session", st->ctx->self));
    st->why = "TLS handshake failed";
    return;
  }
  var what: string = "TLS error";
  if (!st->tls_ready) { what = "TLS handshake failed"; }
  log_warn(fd_log(), what, log_int("session", st->ctx->self), log_str("error", mtls_err_text(rc)));
  st->why = what;
}

fn out_put(st: FdSession*, p: rawptr, n: int64) {
  if (n <= 0 || st->broken) { return; }
  if (alph_outq_push(st->ctx, &st->out, p, n) != ALPH_SENT) { st->broken = true; }
}

fn out_str(st: FdSession*, s: string) {
  out_put(st, (rawptr)s.chars, (int64)s.length);
}

fn out_buf(st: FdSession*, b: StrBuf*) {
  out_put(st, (rawptr)b->data, b->len);
}

// Output waiting to be sent: the queue, and with TLS what mtls holds.
fn out_waiting(st: FdSession*) -> int64 {
  var n: int64 = alph_outq_pending(&st->out);
  if (st->tls_on) { n = n + mtls_nb_pending(&st->tls); }
  return n;
}

fn note_peak(st: FdSession*) {
  var o: int64 = out_waiting(st);
  var h: int64 = alph_heap_used(st->ctx);
  sync_mutex_lock(&g_peak_lock);
  if (o > g_peak_out) { g_peak_out = o; }
  if (h > g_peak_heap) { g_peak_heap = h; }
  sync_mutex_unlock(&g_peak_lock);
}

// ---- input ----

// Next complete line (without \n or \r) into *out, valid until the buffer is
// next refilled. false: no complete line yet.
fn take_line(st: FdSession*, out: string*) -> bool {
  var i: int64 = st->rscan;
  while (i < st->rlen) {
    if (st->rbuf[i] == (uint8)10) {
      var end: int64 = i;
      if (end > st->rstart && st->rbuf[end - 1] == (uint8)13) { end = end - 1; }
      *out = str_from_bytes((cstring)(st->rbuf + st->rstart), end - st->rstart);
      st->rstart = i + 1;
      st->rscan = i + 1;
      return true;
    }
    i = i + 1;
  }
  st->rscan = st->rlen;
  return false;
}

// Makes room to read into: moves the unread bytes to the front and grows the
// buffer. false: the line is longer than LINE_MAX.
fn make_room(st: FdSession*) -> bool {
  if (st->rstart > 0) {
    var rest: int64 = st->rlen - st->rstart;
    if (rest > 0) { memmove((rawptr)st->rbuf, (rawptr)(st->rbuf + st->rstart), rest); }
    st->rlen = rest;
    st->rscan = rest;
    st->rstart = 0;
  }
  if (st->rlen > LINE_MAX) { return false; }   // no newline in all of it
  if (st->rcap - st->rlen < 4096) {
    var cap: int64 = st->rcap * 2;
    if (cap > LINE_MAX + 8192) { cap = LINE_MAX + 8192; }
    if (cap <= st->rcap) { return false; }
    var p: rawptr = alph_realloc(st->ctx, (rawptr)st->rbuf, cap);
    if (p == 0) { return false; }
    st->rbuf = (uint8*)p;
    st->rcap = cap;
  }
  return true;
}

// Reads from the client into buf. Like alph_io_read: a byte count, 0 when the
// client closed, ALPH_IO_AGAIN when nothing is there, or a negative error.
// With TLS the bytes are decrypted.
fn net_read(st: FdSession*, buf: rawptr, cap: int64) -> int64 {
  if (!st->tls_on) { return alph_io_read(st->ctx, st->h, buf, cap); }
  var n: int64 = mtls_nb_read(&st->tls, (uint8*)buf, cap);
  if (n >= 0) { return n; }
  if (n == (int64)MTLS_E_WANT_IO) { return ALPH_IO_AGAIN; }
  if (n == (int64)MTLS_E_EOF) { return 0; }   // the socket closed without close_notify
  tls_fail(st, (int32)n);
  return -1;
}

// With TLS: moves queued output into mtls (which encrypts it and sends what the
// socket takes), as long as mtls has room.
fn tls_feed(st: FdSession*) {
  var q: AlphOutq* = &st->out;
  while (alph_outq_pending(q) > 0 && !st->broken && mtls_nb_pending(&st->tls) < TLS_QUEUE) {
    var k: int64 = alph_outq_pending(q);
    if (k > TLS_CHUNK) { k = TLS_CHUNK; }
    var w: int64 = mtls_nb_write(&st->tls, (uint8*)q->data + q->sent, k);
    if (w < 0) { tls_fail(st, (int32)w); return; }
    q->sent = q->sent + k;
  }
  if (alph_outq_pending(q) == 0) {
    q->len = 0;
    q->sent = 0;
  }
}

// Moves the TLS handshake and the socket traffic along (on every readiness
// message). Sends the greeting when the handshake has just finished.
fn tls_drive(st: FdSession*) {
  var rc: int32 = mtls_nb_pump(&st->tls);
  if (rc != MTLS_OK) { tls_fail(st, rc); return; }
  if (!st->tls_ready && !mtls_nb_handshaking(&st->tls)) {
    st->tls_ready = true;
    out_str(st, GREETING);
  }
}

// ---- login ----

fn is_word(s: string, lower: string) -> bool {
  var buf: uint8[16];
  return fd_lower(s, &buf[0], 16) == lower;
}

fn complete_login(st: FdSession*, welcome: string, how: string) {
  var id: int64 = fd_clients_register(st->ctx->self, fd_user_info_name(&st->sess.user),
                                      fd_user_info_role(&st->sess.user));
  if (id == 0) {
    log_warn(fd_log(), "login refused, server full", log_int("session", st->ctx->self),
             log_str("user", fd_user_info_name(&st->sess.user)));
    out_str(st, "ERROR: Server full\n");
    st->why = "server full";
    st->closing = true;
    return;
  }
  log_info(fd_log(), how, log_int("session", st->ctx->self), log_int("client", id),
           log_str("user", fd_user_info_name(&st->sess.user)), log_str("role", fd_user_info_role(&st->sess.user)));
  st->sess.client_id = id;
  st->registered = true;
  st->mode = MODE_CMD;
  out_str(st, welcome);
  out_str(st, HELP_PROMPT);
}

fn db_error(st: FdSession*, rc: int32) {
  out_str(st, "ERROR: Database error: ");
  out_str(st, fd_status_text(rc));
  out_str(st, "\n");
}

// A job could not run. In a transfer that ends the session (the client and
// the server no longer agree where the data stands).
fn busy_error(st: FdSession*, kind: int32, why: string) {
  log_warn(fd_log(), "server busy", log_int("session", st->ctx->self), log_int("client", st->sess.client_id),
           log_int("job", kind), log_str("why", why));
  if (kind == JOB_LOGIN || kind == JOB_SIGNUP) {
    out_str(st, "ERROR: Server busy, try again\n");
    return;
  }
  out_str(st, "ERROR: Server busy, try again\nCMD_END\n");
  if (st->mode != MODE_CMD) {
    st->why = "transfer failed";
    st->closing = true;
    st->mode = MODE_CMD;
  }
}

// Sends a job (header + text) to the worker pool. The session then waits for
// the answer (st->job); no more lines are run until it comes.
// `text` may be 0 for a header-only job.
fn submit(st: FdSession*, ji: FdJobIn*, text: rawptr, text_len: int64) {
  var hdr: int64 = (int64)sizeof(FdJobIn);
  var total: int64 = hdr + text_len;
  var block: rawptr = alph_scratch(st->ctx, total);
  if (block == 0) { busy_error(st, ji->kind, "no memory"); return; }
  memcpy(block, (rawptr)ji, hdr);
  if (text_len > 0) { memcpy((rawptr)((uint8*)block + hdr), text, text_len); }
  var ref: int64 = alph_offload(st->ctx, st->pool, block, total, JOB_TIMEOUT_MS, &fd_job_run);
  if (ref <= 0) { busy_error(st, ji->kind, "job not queued"); return; }   // pool full or no memory
  st->job = ref;
  st->job_kind = ji->kind;
}

fn handle_auth(st: FdSession*, line: string) {
  var t: string = str_trim(line);
  if (t.length == 0) { return; }
  if (is_word(t, "guest")) {
    if (fd_auth_guest(&st->sess.user) != FD_OK) {
      log_error(fd_log(), "guest login failed", log_int("session", st->ctx->self));
      db_error(st, FD_E_CRYPTO);
      return;
    }
    complete_login(st, "SUCCESS: Logged in as GUEST\n", "guest login");
    return;
  }
  var w: FdWords = fd_next_word(t);
  var u: FdWords = fd_next_word(w.rest);
  if (w.word.length == 0 || u.word.length == 0 || u.rest.length == 0) {
    out_str(st, "ERROR: Invalid format. Use: login <user> <pass>, signup <user> <pass> OR guest\n");
    return;
  }
  var kind: int32 = 0;
  if (is_word(w.word, "login")) { kind = JOB_LOGIN; }
  else if (is_word(w.word, "signup")) { kind = JOB_SIGNUP; }
  else { out_str(st, "ERROR: Unknown command. Use login or signup.\n"); return; }
  // The hash and the database work happen on the pool: text = user, then password.
  var un: int64 = (int64)u.word.length;
  var pn: int64 = (int64)u.rest.length;
  var buf: rawptr = alph_scratch(st->ctx, un + pn);
  if (buf == 0) { busy_error(st, kind, "no memory"); return; }
  memcpy(buf, (rawptr)u.word.chars, un);
  memcpy((rawptr)((uint8*)buf + un), (rawptr)u.rest.chars, pn);
  var ji: FdJobIn;
  memset((rawptr)&ji, 0, (int64)sizeof(FdJobIn));
  ji.kind = kind;
  ji.user_len = un;
  ji.len = un + pn;
  submit(st, &ji, buf, un + pn);
}

// The answer to a login or signup job.
fn auth_done(st: FdSession*, o: FdJobOut*) {
  var rc: int32 = o->rc;
  if (st->job_kind == JOB_LOGIN) {
    if (rc == FD_OK) {
      memcpy((rawptr)&st->sess.user, (rawptr)&o->user, (int64)sizeof(FdUserInfo));
      var a: Arena* = arena_init(4096);
      var sb: StrBuf* = strbuf_new(a, 128);
      strbuf_append_string(sb, "SUCCESS: Welcome back, ");
      strbuf_append_string(sb, fd_user_info_name(&st->sess.user));
      strbuf_append_string(sb, " [");
      strbuf_append_string(sb, fd_user_info_role(&st->sess.user));
      strbuf_append_string(sb, "]\n");
      complete_login(st, strbuf_finish_string(sb), "login");
      arena_free(a);
    } else if (rc == FD_E_DENIED || rc == FD_E_INVALID || rc == FD_E_NOT_FOUND) {
      out_str(st, "ERROR: Invalid username or password\n");
    } else if (rc == FD_E_LOCKED) {
      out_str(st, "ERROR: Too many failed logins. Try again later\n");
    } else {
      db_error(st, rc);
    }
  } else {
    if (rc == FD_OK) {
      out_str(st, "SUCCESS: User registered. Please login.\n");
      st->closing = true;
    } else if (rc == FD_E_EXISTS) {
      out_str(st, "ERROR: Username already exists\n");
    } else if (rc == FD_E_INVALID) {
      out_str(st, "ERROR: Invalid username or password (password needs 8 or more characters)\n");
    } else {
      db_error(st, rc);
    }
  }
}

// ---- commands ----

// Starts one command on the pool.
fn run_command(st: FdSession*, line: string) {
  var ji: FdJobIn;
  memset((rawptr)&ji, 0, (int64)sizeof(FdJobIn));
  ji.kind = JOB_CMD;
  ji.len = (int64)line.length;
  memcpy((rawptr)&ji.sess, (rawptr)&st->sess, (int64)sizeof(FdSess));
  submit(st, &ji, (rawptr)line.chars, (int64)line.length);
}

// ---- transfers ----

// Starts the stall check for the transfer that just began.
fn start_ticks(st: FdSession*) {
  st->x_last = time_mono_ms();
  if (st->ticking) { return; }
  st->ticking = true;
  st->tick_gen = st->tick_gen + 1;
  alph_send_after(st->ctx, fd_xfer_tick_ms(), st->ctx->self, TAG_TICK, st->tick_gen);
}

// A transfer job for the transfer in progress (header only, or one line).
fn submit_xfer(st: FdSession*, kind: int32, size: int64, text: string) {
  var ji: FdJobIn;
  memset((rawptr)&ji, 0, (int64)sizeof(FdJobIn));
  ji.kind = kind;
  ji.len = (int64)text.length;
  ji.size = size;
  ji.xfer = st->xfer;
  memcpy((rawptr)&ji.sess, (rawptr)&st->sess, (int64)sizeof(FdSess));
  submit(st, &ji, (rawptr)text.chars, (int64)text.length);
}

// A broken transfer protocol: the error, CMD_END, and the session closes.
fn violation(st: FdSession*, why: string) {
  log_warn(fd_log(), "transfer protocol error", log_int("session", st->ctx->self),
           log_int("client", st->sess.client_id), log_str("error", why));
  out_str(st, "ERROR: ");
  out_str(st, why);
  out_str(st, "\nCMD_END\n");
  st->why = "protocol error";
  st->closing = true;
  st->mode = MODE_CMD;
}

// The line after READY: `SIZE <bytes>`.
fn handle_size(st: FdSession*, line: string) {
  if (str_starts_with(line, "SIZE ") == 0) { violation(st, "Expected SIZE <bytes>"); return; }
  var n: int64 = fd_parse_count(str_slice(line, 5, (int64)line.length - 5));
  if (n < 0) { violation(st, "Bad SIZE"); return; }
  st->x_last = time_mono_ms();
  submit_xfer(st, JOB_UP_BEGIN, n, "");
}

// A data line, or `EOF <sha256-hex>`.
fn handle_data(st: FdSession*, line: string) {
  st->x_last = time_mono_ms();
  if (str_starts_with(line, "EOF") != 0) {
    var hex: string = "";
    if ((int64)line.length > 4 && line.chars[3] == ' ') { hex = str_slice(line, 4, (int64)line.length - 4); }
    submit_xfer(st, JOB_UP_END, 0, hex);
    return;
  }
  submit_xfer(st, JOB_UP_DATA, 0, line);
}

// The answer to a transfer job.
fn xfer_done(st: FdSession*, kind: int32, o: FdJobOut*, size: int64) {
  var hdr: int64 = (int64)sizeof(FdJobOut);
  if (size < hdr + o->reply_len) { busy_error(st, kind, "short result"); return; }
  var reply: uint8* = (uint8*)o + hdr;
  st->x_last = time_mono_ms();
  if (kind == JOB_UP_BEGIN) {
    out_put(st, (rawptr)reply, o->reply_len);
    if (o->xfer == 0) { out_str(st, "CMD_END\n"); st->mode = MODE_CMD; return; }
    st->xfer = o->xfer;
    st->mode = MODE_UP_DATA;
    return;
  }
  if (kind == JOB_UP_DATA) {
    if (o->rc == FD_OK) { return; }
    out_put(st, (rawptr)reply, o->reply_len);   // the upload was discarded
    out_str(st, "CMD_END\n");
    st->xfer = 0;
    st->mode = MODE_CMD;
    st->why = "bad upload data";
    st->closing = true;
    return;
  }
  if (kind == JOB_UP_END) {
    out_put(st, (rawptr)reply, o->reply_len);
    out_str(st, "CMD_END\n");
    st->xfer = 0;
    st->mode = MODE_CMD;
    return;
  }
  // JOB_DL_READ
  out_put(st, (rawptr)reply, o->reply_len);
  note_peak(st);
  if (o->done) {
    out_str(st, "CMD_END\n");
    st->xfer = 0;
    st->mode = MODE_CMD;
  }
}

// With a download running and its output drained below DL_LOW, asks for the
// next lines.
fn download_more(st: FdSession*) {
  if (st->mode != MODE_DOWNLOAD || st->job != 0 || st->closing || st->broken) { return; }
  if (out_waiting(st) >= DL_LOW) { return; }
  submit_xfer(st, JOB_DL_READ, 0, "");
}

// No progress for too long: the error goes out if the socket takes it, and
// the session ends (its exit hook detaches the transfer).
fn stalled(st: FdSession*) -> int64 {
  log_warn(fd_log(), "transfer stalled", log_int("session", st->ctx->self), log_int("client", st->sess.client_id),
           log_str("user", fd_user_info_name(&st->sess.user)), log_int("mode", st->mode));
  out_str(st, "ERROR: Transfer timed out\nCMD_END\n");
  if (st->tls_on) { tls_feed(st); mtls_nb_pump(&st->tls); }
  else { alph_outq_flush(st->ctx, &st->out, st->h); }
  st->why = "transfer timed out";
  return end_session(st->ctx, st);
}

// The stall check, every fd_xfer_tick_ms while a transfer runs.
fn on_tick(st: FdSession*, gen: int64) -> int64 {
  if (gen != st->tick_gen) { return ALPH_CONTINUE; }
  st->ticking = false;
  if (st->mode != MODE_UP_SIZE && st->mode != MODE_UP_DATA && st->mode != MODE_DOWNLOAD) { return ALPH_CONTINUE; }
  if (st->xfer != 0) { fd_xfer_touch(st->xfer, st->ctx->self); }
  if (st->job == 0 && time_mono_ms() - st->x_last > g_xfer_stall_ms) { return stalled(st); }
  st->ticking = true;
  alph_send_after(st->ctx, fd_xfer_tick_ms(), st->ctx->self, TAG_TICK, st->tick_gen);
  return ALPH_CONTINUE;
}

// The answer to a command job: the reply, then what the command asked for.
fn command_done(st: FdSession*, o: FdJobOut*, size: int64) {
  var hdr: int64 = (int64)sizeof(FdJobOut);
  if (size < hdr + o->reply_len) { busy_error(st, JOB_CMD, "short result"); return; }
  memcpy((rawptr)&st->sess, (rawptr)&o->sess, (int64)sizeof(FdSess));
  var reply: uint8* = (uint8*)o + hdr;
  out_put(st, (rawptr)reply, o->reply_len);
  var act: int32 = st->sess.action;
  if (act == FD_ACT_UPLOAD) {
    if (st->sess.up_lz4) { out_str(st, READY_LZ4); } else { out_str(st, READY); }
    st->mode = MODE_UP_SIZE;
    start_ticks(st);
    return;
  }
  if (act == FD_ACT_DOWNLOAD) {
    st->xfer = st->sess.xfer;
    st->x_left = 0;
    st->mode = MODE_DOWNLOAD;
    start_ticks(st);
    return;
  }
  out_str(st, "CMD_END\n");
  if (act == FD_ACT_QUIT) { st->why = "quit"; st->closing = true; }
  if (act == FD_ACT_KICK) {
    var c: FdClient;
    if (st->sess.act_arg == st->sess.client_id) {
      st->why = "kicked (self)";
      st->closing = true;
    } else if (fd_clients_find(st->sess.act_arg, &c)) {
      alph_send(st->ctx, c.pid, TAG_KICK, 0);   // it ends itself
    }
  }
  if (act == FD_ACT_SHUTDOWN) { st->why = "server shutdown"; st->shutting = true; }   // acted on once the reply is written
}

fn handle_line(st: FdSession*, line: string) {
  if (st->mode == MODE_AUTH) { handle_auth(st, line); return; }
  if (st->mode == MODE_UP_SIZE) { handle_size(st, line); return; }
  if (st->mode == MODE_UP_DATA) { handle_data(st, line); return; }
  run_command(st, str_trim(line));
}

// ---- the actor ----

// Ends the session: unregisters it; the exit hook closes the TLS state, and the
// runtime frees the heap and closes the handle.
fn end_session(ctx: AlphCtx*, st: FdSession*) -> int64 {
  var why: string = st->why;
  if (why.length == 0) { why = "closed by client"; }
  if (st->registered) {
    log_info(fd_log(), "client disconnected", log_int("session", ctx->self), log_int("client", st->sess.client_id),
             log_str("user", fd_user_info_name(&st->sess.user)), log_str("why", why));
  } else {
    log_info(fd_log(), "client disconnected", log_int("session", ctx->self), log_str("why", why));
  }
  if (st->registered) { fd_clients_unregister(st->sess.client_id); st->registered = false; }
  return alph_stop(ctx, ALPH_NORMAL);
}

// Runs once when the session exits for any reason, crash included, before alph
// closes the socket: detaches the session's transfers (their files are closed,
// a partial upload is kept for resume) and closes the TLS state (close_notify
// if it can be sent).
fn session_exit(ctx: AlphCtx*, reason: int64) -> int64 {
  var st: FdSession* = (FdSession*)ctx->state;
  fd_xfer_detach(ctx->self);
  if (st->tls_on) { mtls_nb_close(&st->tls); }
  return 0;
}

// Writes what the socket takes; ends the session when it is done or broken,
// otherwise arms the handle again: for input unless a job is out (the answer
// comes as a message, and the next line waits for it), for output while some is waiting.
fn settle(ctx: AlphCtx*, st: FdSession*) -> int64 {
  if (st->broken) {
    if (st->why.length == 0) {
      log_error(fd_log(), "cannot queue output", log_int("session", ctx->self), log_int("client", st->sess.client_id));
      st->why = "output failed";
    }
    return end_session(ctx, st);
  }
  var left: int64 = 0;
  if (st->tls_on) {
    tls_feed(st);
    if (st->broken) { return end_session(ctx, st); }
    left = alph_outq_pending(&st->out) + mtls_nb_pending(&st->tls);
  } else {
    left = alph_outq_flush(ctx, &st->out, st->h);
    if (left < 0) {
      log_error(fd_log(), "write failed", log_int("session", ctx->self), log_int("client", st->sess.client_id),
                log_int("errno", -left));
      st->why = "write failed";
      return end_session(ctx, st);
    }
  }
  if (st->mode == MODE_DOWNLOAD) {
    if (left < st->x_left) { st->x_last = time_mono_ms(); }   // the reader is taking it
    download_more(st);
  }
  st->x_left = left;
  if (st->shutting) {
    st->shutting = false;
    alph_shutdown(ctx, 500, 0);   // the reply was queued first; flushed above
  }
  if (st->closing && left == 0 && st->job == 0) { return end_session(ctx, st); }
  var events: int64 = 0;
  if (st->tls_on) {
    events = mtls_nb_wants(&st->tls);
    if (st->closing || st->job != 0) { events = events & ALPH_IO_OUT; }
  } else {
    if (!st->closing && st->job == 0) { events = ALPH_IO_IN; }
    if (left > 0) { events = events | ALPH_IO_OUT; }
  }
  if (events != 0) { alph_io_arm(ctx, st->h, events); }
  return ALPH_CONTINUE;
}

// Runs every complete line in the buffer, until a job is started. During a
// download lines wait in the buffer.
fn run_lines(st: FdSession*) {
  var line: string = "";
  while (!st->closing && !st->broken && st->job == 0 && st->mode != MODE_DOWNLOAD && take_line(st, &line)) {
    handle_line(st, line);
  }
}

// Runs buffered lines, then reads what has arrived (bounded, so the handler
// returns promptly) and runs those, until a job is out, nothing is left or the
// session is ending.
fn read_input(st: FdSession*) {
  var reads: int32 = 0;
  while (true) {
    run_lines(st);
    if (st->closing || st->broken || st->job != 0) { return; }
    if (reads >= 16) {
      // The socket announces more input by itself; decrypted bytes waiting inside mtls do not.
      if (st->tls_on) { alph_send(st->ctx, st->ctx->self, TAG_MORE, 0); }
      return;
    }
    if (!make_room(st)) {
      log_warn(fd_log(), "line too long", log_int("session", st->ctx->self), log_int("client", st->sess.client_id));
      out_str(st, "ERROR: Line too long\n");
      if (st->mode != MODE_AUTH) { out_str(st, "CMD_END\n"); }
      st->why = "line too long";
      st->closing = true;
      return;
    }
    var n: int64 = net_read(st, (rawptr)(st->rbuf + st->rlen), st->rcap - st->rlen);
    if (n == ALPH_IO_AGAIN) { return; }
    if (n <= 0) {   // closed or failed: leave once the output is out
      if (n < 0 && st->why.length == 0) {
        log_error(fd_log(), "read failed", log_int("session", st->ctx->self), log_int("client", st->sess.client_id),
                  log_int("errno", -n));
        st->why = "read failed";
      }
      st->closing = true;
      return;
    }
    st->rlen = st->rlen + n;
    reads = reads + 1;
  }
}

// The pool's answer for the job in flight (DONE, or FAILED, DOWN, TIMEOUT).
fn job_answer(st: FdSession*, m: AlphMsg*) {
  var kind: int32 = st->job_kind;
  st->job = 0;
  var size: int64 = 0;
  var data: rawptr = alph_msg_bytes(m, &size);
  if (m->tag != ALPH_TAG_DONE || m->arg != 0 || size < (int64)sizeof(FdJobOut)) {
    if (m->tag == ALPH_TAG_TIMEOUT) {
      busy_error(st, kind, "job timed out");
    } else {
      log_error(fd_log(), "job failed", log_int("session", st->ctx->self), log_int("client", st->sess.client_id),
                log_int("job", kind), log_int("tag", m->tag), log_int("arg", m->arg));
      busy_error(st, kind, "job failed");
    }
    return;
  }
  if (kind == JOB_LOGIN || kind == JOB_SIGNUP) { auth_done(st, (FdJobOut*)data); }
  else if (kind == JOB_CMD) { command_done(st, (FdJobOut*)data, size); }
  else { xfer_done(st, kind, (FdJobOut*)data, size); }
}

/// The session actor. Its state is a zeroed FdSession with the pool's pid; the
/// client socket's handle arrives in ALPH_TAG_IO_GIVEN.
export fn fd_session_actor(ctx: AlphCtx*, m: AlphMsg*) -> int64 {
  var st: FdSession* = (FdSession*)ctx->state;
  st->ctx = ctx;
  if (m->tag == ALPH_TAG_IO_GIVEN) {
    st->h = m->ref;
    fd_sess_init(&st->sess);
    st->sess.pid = ctx->self;
    st->mode = MODE_AUTH;
    alph_on_exit(ctx, &session_exit);
    alph_outq_init(&st->out, OUT_LIMIT);
    st->rbuf = (uint8*)alph_alloc(ctx, RBUF_START);
    if (st->rbuf == 0) {
      log_error(fd_log(), "no memory for a client", log_int("session", ctx->self));
      st->why = "no memory";
      return end_session(ctx, st);
    }
    st->rcap = RBUF_START;
    alph_tcp_nodelay(ctx, st->h, true);
    var ip: int64 = 0;
    var port: int64 = 0;
    var peer: string = "unknown";
    if (alph_tcp_peer(ctx, st->h, &ip, &port) == 0) {
      peer = "{(ip >> 24) & 255}.{(ip >> 16) & 255}.{(ip >> 8) & 255}.{ip & 255}:{port}";
    }
    log_info(fd_log(), "client connected", log_int("session", ctx->self), log_str("peer", peer),
             log_bool("tls", g_tls_on));
    if (g_tls_on) {
      var trc: int32 = mtls_nb_server(&st->tls, alph_io_fd(ctx, st->h), &g_tls_cfg);   // alph keeps the socket
      if (trc != MTLS_OK) {
        log_error(fd_log(), "cannot start TLS for a client", log_int("session", ctx->self),
                  log_str("error", mtls_err_text(trc)));
        st->why = "TLS setup failed";
        return end_session(ctx, st);
      }
      st->tls_on = true;   // the handshake runs on the readiness messages; the greeting follows it
    } else {
      out_str(st, GREETING);
    }
    return settle(ctx, st);
  }
  if (st->h == 0) { return ALPH_CONTINUE; }   // INIT: the handle has not arrived yet
  if (m->tag == TAG_KICK) { st->why = "kicked"; return end_session(ctx, st); }
  if (m->tag == TAG_MORE) {
    read_input(st);
    return settle(ctx, st);
  }
  if (m->tag == TAG_TICK) { return on_tick(st, m->arg); }
  if (st->job != 0 && m->ref == st->job) {
    job_answer(st, m);
    read_input(st);   // lines that arrived while the job ran
    return settle(ctx, st);
  }
  if (m->tag == ALPH_TAG_IO && m->ref == st->h) {
    if (st->tls_on) {
      tls_drive(st);
      if (st->tls_ready && !st->broken) { read_input(st); }
    } else if ((m->arg & ALPH_IO_IN) != 0 || (m->arg & (ALPH_IO_ERR | ALPH_IO_HUP)) != 0) {
      read_input(st);
    }
    return settle(ctx, st);
  }
  return ALPH_CONTINUE;
}

/// Asks the dynamic supervisor `sup` to start a session actor that uses the
/// worker pool `pool` (zeroed state otherwise).
/// returns: the request ref (> 0; ALPH_TAG_STARTED later carries the pid), or
///          ALPH_FULL / ALPH_NOMEM when it was not sent
export fn fd_session_start(ctx: AlphCtx*, sup: int64, pool: int64, timeout_ms: int64) -> int64 {
  var st: FdSession;
  memset((rawptr)&st, 0, (int64)sizeof(FdSession));
  st.pool = pool;
  return alph_dyn_start_value<FdSession>(ctx, sup, &st, timeout_ms);
}

/// A dynamic supervisor spec for sessions: they are not restarted when they end.
export fn fd_session_spec(spec: AlphDynSpec*) {
  alph_dyn_init(spec, &fd_session_actor);
  spec->restart = ALPH_TEMPORARY;
}
