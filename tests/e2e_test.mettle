// tests/e2e_test: the server and the client connection over loopback.
// An embedded meodb (harness.mettle) and the real server code (alph acceptor and
// session actors) in this process on an OS-chosen port; the client side is
// src/client/conn.mettle, the library freedrs_client is built on. Script:
// login, mkdir, upload, list, download, a path traversal, a guest refused,
// quit. A test program: `mbuild test e2e`.

import "std/io";
import "std/mem";
import "std/conv";
import "std/arena";
import "std/strbuf";
import "std/socket";
import "harness";
import "freedrs/status";
import "freedrs/config/config";
import "freedrs/auth/auth";
import "freedrs/db/store";
import "freedrs/vfs/vfs";
import "freedrs/setup/setup";
import "freedrs/server/state";
import "freedrs/server/serve";
import "freedrs/client/conn";

// Reads reply lines up to CMD_END into one string (lines joined by \n).
fn reply(a: Arena*) -> string {
  var b: StrBuf* = strbuf_new(a, 256);
  var line: string;
  while (fd_conn_next_line(&line)) {
    if (line == "CMD_END") { fd_conn_free_line(line); break; }
    strbuf_append_string(b, line);
    strbuf_append_byte(b, (uint8)10);
    fd_conn_free_line(line);
  }
  return strbuf_finish_string(b);
}

fn cmd(a: Arena*, line: string) -> string {
  fd_conn_send_line(line);
  return reply(a);
}

fn has(s: string, needle: string) -> bool {
  return str_contains(s, needle) != 0;
}

fn run(addr: string) -> int32 {
  var rc: int32 = fd_db_open(&g_db, addr, "");
  th_check("db open", rc == FD_OK);
  if (rc != FD_OK) { return 1; }
  fd_roles_seed(&g_db);
  th_check("auth init", fd_auth_init(&g_auth, &g_db) == FD_OK);
  th_check("setup admin", fd_setup_run(&g_auth, "admin", "admin password") == FD_OK);
  th_check("vfs init", fd_vfs_init(&g_vfs, &g_db, ".mbuild/e2e_root") == FD_OK);

  var port: int64 = 0;
  var msg: string = "";
  th_check("server start", fd_server_start(0, &port, &msg) && port > 0);
  if (port <= 0) { return 1; }

  th_check("connect", fd_conn_open("127.0.0.1", (int32)port, false, &msg));
  var a: Arena* = arena_init(65536);
  var line: string;
  th_check("greeting 1", fd_conn_next_line(&line) && has(line, "Distributed File System"));
  th_check("greeting 2", fd_conn_next_line(&line) && has(line, "login <user> <pass>"));

  fd_conn_send_line("login admin wrong password");
  th_check("bad login", fd_conn_next_line(&line) && line == "ERROR: Invalid username or password");
  fd_conn_send_line("login admin admin password");
  th_check("login", fd_conn_next_line(&line) && line == "SUCCESS: Welcome back, admin [admin]");
  th_check("help prompt", fd_conn_next_line(&line) && has(line, "'help'"));

  th_check("mkdir", has(cmd(a, "mkdir docs"), "SUCCESS: Directory created: docs"));
  th_check("cd", has(cmd(a, "cd docs"), "Changed directory to: /docs"));

  // upload "hello world\n" (aGVsbG8gd29ybGQK) to docs/x.txt, as the client does it
  fd_conn_send_line("upload local.txt x.txt");
  th_check("ready", fd_conn_next_line(&line) && has(line, "READY:"));
  fd_conn_send_line("aGVsbG8gd29ybGQK");
  fd_conn_send_line("EOF");
  var up: string = reply(a);
  th_check("uploaded", has(up, "SUCCESS: File uploaded: docs/x.txt [file] 12B - admin"));

  var ls: string = cmd(a, "list");
  th_check("list", has(ls, "Files in docs/:") && has(ls, "docs/x.txt [file] 12B"));
  th_check("myfiles", has(cmd(a, "myfiles"), "docs/x.txt"));

  var dl: string = cmd(a, "download x.txt");
  th_check("download data", has(dl, "FILE_DATA:\naGVsbG8gd29ybGQK\nEND_FILE\nSUCCESS: File sent"));
  th_check("download missing", has(cmd(a, "download nope.txt"), "ERROR: File not found: docs/nope.txt"));
  th_check("traversal", has(cmd(a, "download ../../etc/passwd"), "ERROR: Path traversal not allowed"));
  th_check("ping", has(cmd(a, "ping"), "PONG"));
  th_check("delete", has(cmd(a, "delete x.txt"), "SUCCESS: File deleted"));
  th_check("whoami", has(cmd(a, "whoami"), "(admin)"));
  th_check("unknown", has(cmd(a, "frobnicate"), "ERROR: Unknown command"));
  th_check("quit", has(cmd(a, "quit"), "Goodbye!"));
  fd_conn_close();

  // a guest may list but not mkdir
  th_check("connect guest", fd_conn_open("127.0.0.1", (int32)port, false, &msg));
  fd_conn_next_line(&line);
  fd_conn_next_line(&line);
  fd_conn_send_line("guest");
  th_check("guest login", fd_conn_next_line(&line) && has(line, "GUEST"));
  fd_conn_next_line(&line);
  th_check("guest list", has(cmd(a, "list"), "docs"));
  th_check("guest denied", has(cmd(a, "mkdir nope"), "Permission denied"));
  fd_conn_close();
  arena_free(a);
  return 0;
}

fn main() -> int32 {
  var addr: string = th_start(".mbuild/test_e2e.meo");
  if (addr.length == 0) { return 1; }
  run(addr);
  if (th_failures() > 0) {
    println("FAIL e2e_test: {th_failures()} checks failed");
    return 1;   // the server thread and meodb die with the process
  }
  println("PASS e2e_test");
  return 0;
}
